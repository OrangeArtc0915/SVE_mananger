---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

const categories = ["入门", "使用", "疑难排查", "扩展开发", "关于"];

const entries = await getCollection("wiki");

const items = entries
	.map((entry) => ({
		slug: entry.slug,
		title: entry.data.title,
		description: entry.data.description,
		category: entry.data.category,
		order: entry.data.order ?? 0,
	}))
	.sort((a, b) => {
		const ca = categories.indexOf(a.category);
		const cb = categories.indexOf(b.category);
		if (ca !== cb) return (ca < 0 ? 99 : ca) - (cb < 0 ? 99 : cb);
		if (a.order !== b.order) return a.order - b.order;
		return a.title.localeCompare(b.title, "zh-CN");
	});

const groups = categories
	.map((category) => ({
		category,
		items: items.filter((item) => item.category === category),
	}))
	.filter((group) => group.items.length > 0);

// 有归到未知分类的条目也不丢，单独列出来
const known = new Set(categories);
const others = items.filter((item) => !known.has(item.category));
if (others.length > 0) groups.push({ category: "其他", items: others });
---

<MainGridLayout
	title="Wiki"
	description="星露谷启动器 Wiki：安装与快速上手、游戏实例、SMAPI、Mod 管理、樱花 FRP 联机、设置详解与故障排查。"
>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
			<div class="flex flex-col items-start justify-center mb-6">
				<div class="flex items-center gap-2 mb-2">
					<Icon name="material-symbols:menu-book-rounded" class="text-4xl text-[var(--primary)]" />
					<h1 class="text-4xl font-bold text-black/90 dark:text-white/90">Wiki</h1>
				</div>
				<p class="text-75 text-sm leading-relaxed">
					从下载安装到联机开房，把启动器的每个功能讲清楚。遇到问题先看
					<a class="link-underline text-[var(--primary)]" href={url("/wiki/faq/")}>常见问题</a>
					与
					<a class="link-underline text-[var(--primary)]" href={url("/wiki/troubleshooting/")}>故障排查</a>。
				</p>
			</div>

			<div class="grid gap-6">
				{groups.map((group) => (
					<section>
						<div class="flex items-center gap-2 mb-3">
							<span class="inline-block w-1 h-5 rounded-md bg-[var(--primary)]"></span>
							<h2 class="text-xl font-bold text-90">{group.category}</h2>
							<span class="text-50 text-xs">{group.items.length} 篇</span>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							{group.items.map((item, index) => (
								<a
									href={url(`/wiki/${item.slug}/`)}
									class="group rounded-[var(--radius-large)] bg-[var(--btn-regular-bg)] p-4 transition-all duration-150 hover:bg-[var(--btn-regular-bg-hover)] hover:-translate-y-0.5 block"
									style={`animation-delay: ${index * 30}ms`}
								>
									<div class="flex items-center justify-between gap-2 mb-1">
										<h3 class="font-bold text-90">{item.title}</h3>
										<Icon
											name="material-symbols:arrow-forward-rounded"
											class="text-[1.1rem] text-50 transition-transform duration-150 group-hover:translate-x-1 group-hover:text-[var(--primary)]"
										/>
									</div>
									{item.description && (
										<p class="text-75 text-[0.85rem] leading-relaxed">{item.description}</p>
									)}
								</a>
							))}
						</div>
					</section>
				))}
			</div>
		</div>
	</div>

	<div class="card-base p-6 mt-4 mb-4 text-75 text-[0.85rem] leading-relaxed">
		<div class="flex items-start gap-2">
			<Icon name="material-symbols:lightbulb-outline-rounded" class="text-[1.2rem] text-[var(--primary)] mt-0.5" />
			<p>
				启动器版本 <b class="text-90">v1.6.1</b>。手册里的路径都以「启动器目录」为参照：首次运行后会在 exe
				同级生成 <code>Data\</code>，所有实例、设置与日志都在里面。
			</p>
		</div>
	</div>
</MainGridLayout>
