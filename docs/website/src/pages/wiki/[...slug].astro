---
import { getCollection, getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";

const categories = ["入门", "使用", "疑难排查", "关于"];

export async function getStaticPaths() {
	const entries = await getCollection("wiki");
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;

// 正文可以直接写在 wiki 里，也可以用 ref 指到别处（例如赞助说明与 /helpus/ 共用一份）
const [refCollection, refSlug] = (entry.data.ref ?? "").split("/");
const refEntry = refCollection && refSlug ? await getEntry(refCollection as "spec", refSlug) : undefined;
const { Content, headings } = refEntry ? await render(refEntry) : await render(entry);

// 与目录页用同一套排序，用来算上一页 / 下一页
const all = (await getCollection("wiki"))
	.map((item) => ({
		slug: item.slug,
		title: item.data.title,
		category: item.data.category,
		order: item.data.order ?? 0,
	}))
	.sort((a, b) => {
		const ca = categories.indexOf(a.category);
		const cb = categories.indexOf(b.category);
		if (ca !== cb) return (ca < 0 ? 99 : ca) - (cb < 0 ? 99 : cb);
		if (a.order !== b.order) return a.order - b.order;
		return a.title.localeCompare(b.title, "zh-CN");
	});

const current = all.findIndex((item) => item.slug === entry.slug);
const prev = current > 0 ? all[current - 1] : undefined;
const next = current >= 0 && current < all.length - 1 ? all[current + 1] : undefined;
---

<MainGridLayout title={entry.data.title} description={entry.data.description} headings={headings}>
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<div class="card-base z-10 px-6 md:px-9 pt-6 pb-8 relative w-full">
			<!-- 面包屑 -->
			<div class="flex flex-wrap items-center gap-2 text-sm text-50 mb-5 onload-animation">
				<a href={url("/wiki/")} class="transition hover:text-[var(--primary)] flex items-center gap-1">
					<Icon name="material-symbols:menu-book-rounded" class="text-[1.05rem]" />
					<span>Wiki</span>
				</a>
				<Icon name="material-symbols:chevron-right-rounded" class="text-[1.05rem] opacity-60" />
				<span class="text-75">{entry.data.category}</span>
			</div>

			<!-- 标题 -->
			<h1
				class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90
                       relative md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                       before:absolute before:top-[0.75rem] before:left-[-1.125rem] onload-animation"
			>
				{entry.data.title}
			</h1>

			{
				entry.data.description && (
					<p class="text-75 text-[0.95rem] leading-relaxed mb-6 onload-animation">
						{entry.data.description}
					</p>
				)
			}

			<div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-6" />

			<Markdown class="mb-2 markdown-content onload-animation">
				<Content />
			</Markdown>
		</div>
	</div>

	<!-- 上一篇 / 下一篇 -->
	<div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
		<a
			href={prev ? url(`/wiki/${prev.slug}/`) : "#"}
			class:list={["w-full font-bold overflow-hidden active:scale-95", { "pointer-events-none opacity-40": !prev }]}
			aria-label={prev ? `上一篇：${prev.title}` : "已是第一篇"}
		>
			<div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4">
				<Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
				<div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
					{prev ? prev.title : "已是第一篇"}
				</div>
			</div>
		</a>

		<a
			href={next ? url(`/wiki/${next.slug}/`) : "#"}
			class:list={["w-full font-bold overflow-hidden active:scale-95", { "pointer-events-none opacity-40": !next }]}
			aria-label={next ? `下一篇：${next.title}` : "已是最后一篇"}
		>
			<div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
				<div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
					{next ? next.title : "已是最后一篇"}
				</div>
				<Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
			</div>
		</a>
	</div>

	<!-- 返回目录 -->
	<div class="card-base p-6 mb-4">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<div class="flex items-center gap-2 text-75 text-[0.85rem]">
				<Icon name="material-symbols:lightbulb-outline-rounded" class="text-[1.2rem] text-[var(--primary)]" />
				<span>没找到答案？先看 <a class="link-underline text-[var(--primary)]" href={url("/wiki/faq/")}>常见问题</a> 与 <a class="link-underline text-[var(--primary)]" href={url("/wiki/troubleshooting/")}>故障排查</a>。</span>
			</div>
			<a
				href={url("/wiki/")}
				class="btn-regular rounded-lg h-10 px-4 flex items-center gap-2 transition active:scale-95"
			>
				<Icon name="material-symbols:list-rounded" class="text-[1.1rem]" />
				<span class="text-sm font-bold">全部文档</span>
			</a>
		</div>
	</div>
</MainGridLayout>
