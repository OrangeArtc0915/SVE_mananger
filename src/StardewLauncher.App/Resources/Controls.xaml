<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:StardewLauncher.App.Controls"
                    xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <!-- ===================== 基础排版 ===================== -->

    <!-- 不设置 Foreground：让文字颜色从父级继承，避免覆盖按钮内的浅色文字 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ===================== 滚动条 ===================== -->

    <Style TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Margin="3,0"
                            Background="{DynamicResource Text.Tertiary}"
                            CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontal" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Margin="0,3"
                            Background="{DynamicResource Text.Tertiary}"
                            CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb MinWidth="24" Style="{StaticResource ScrollBarThumbHorizontal}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 卡片 ===================== -->

    <Style TargetType="{x:Type c:SurfaceCard}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SurfaceCard}">
                    <Border x:Name="CardBorder"
                            Background="{DynamicResource Surface.CardGlass}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Radius.Card}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              Direction="270"
                                              Opacity="0.1"
                                              ShadowDepth="2"
                                              Color="{DynamicResource Shadow.Tint}" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TitleElement"
                                       Grid.Row="0"
                                       Margin="16,14,16,0"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 文字按钮 ===================== -->

    <Style TargetType="{x:Type c:OutlineButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:OutlineButton}">
                    <Border x:Name="Face"
                            Background="{DynamicResource Surface.Card}"
                            BorderBrush="{DynamicResource Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 点击水波纹层。静止时整层不可见，动画收尾后把自己收起来，自检也就不会捡到它 -->
                            <Canvas x:Name="RippleLayer"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False">
                                <Ellipse x:Name="Ripple"
                                         Width="1"
                                         Height="1"
                                         Opacity="0"
                                         Visibility="Collapsed" />
                            </Canvas>

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 圆形图标按钮 ===================== -->

    <Style TargetType="{x:Type c:RoundIconButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RoundIconButton}">
                    <Border x:Name="Hit"
                            Background="{DynamicResource Common.Transparent}"
                            CornerRadius="{StaticResource Radius.Pill}">
                        <Grid>
                            <Canvas x:Name="RippleLayer"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False">
                                <Ellipse x:Name="Ripple"
                                         Width="1"
                                         Height="1"
                                         Opacity="0"
                                         Visibility="Collapsed" />
                            </Canvas>

                            <svg:SvgIcon x:Name="IconElement"
                                         Width="{TemplateBinding IconSize}"
                                         Height="{TemplateBinding IconSize}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 侧栏导航项 ===================== -->

    <Style TargetType="{x:Type c:NavItem}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:NavItem}">
                    <Border x:Name="Back"
                            Height="42"
                            Background="{DynamicResource Common.Transparent}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Indicator"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Nav.Indicator}"
                                    CornerRadius="2" />

                            <svg:SvgIcon x:Name="IconElement"
                                         Grid.Column="1"
                                         Width="{TemplateBinding IconSize}"
                                         Height="{TemplateBinding IconSize}"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         IconBrush="{DynamicResource Nav.Text}" />

                            <TextBlock x:Name="TextElement"
                                       Grid.Column="2"
                                       Margin="10,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       Foreground="{DynamicResource Nav.Text}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
