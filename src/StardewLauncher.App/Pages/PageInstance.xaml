<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageInstance"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls"
                xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：标题占剩余宽度、工具组固定靠右，两列布局保证窄窗口下不会相互叠压 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold" Text="游戏实例" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="每个实例对应一套游戏目录，Mod 直接放在游戏目录的 Mods 里"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="240"
                        Height="38"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgIcon Grid.Column="0"
                                     Width="15"
                                     Height="15"
                                     VerticalAlignment="Center"
                                     Icon="lucide/search"
                                     IconBrush="{DynamicResource Text.Tertiary}" />

                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>

                <c:OutlineButton Margin="8,0,0,0"
                                 Content="新建实例"
                                 Tone="Solid"
                                 Click="OnNewInstanceClick" />
            </StackPanel>
        </Grid>

        <!-- 实例列表 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="PanInstances">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel Mode="AutoFit"
                                            ColumnGap="14"
                                            ItemWidth="340"
                                            RowGap="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Padding="0"
                                           UseShadow="False"
                                           Loaded="OnInstanceCardLoaded">
                                <Grid Margin="16,14,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 0 标题 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="40"
                                                Height="40"
                                                Background="{DynamicResource Accent.Faint}"
                                                CornerRadius="{StaticResource Radius.Item}">
                                            <svg:SvgIcon Width="20"
                                                         Height="20"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center">
                                                <svg:SvgIcon.Style>
                                                    <Style TargetType="svg:SvgIcon">
                                                        <Setter Property="Icon" Value="lucide/layers" />
                                                        <Setter Property="IconBrush" Value="{DynamicResource Accent.Base}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Icon" Value="lucide/triangle-alert" />
                                                                <Setter Property="IconBrush" Value="{DynamicResource Status.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </svg:SvgIcon.Style>
                                            </svg:SvgIcon>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <Border Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="{StaticResource Radius.Pill}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Accent.Faint}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVanilla}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding KindText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent.Base}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVanilla}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="2"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Status.Danger}"
                                                           Text="游戏目录不可用">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{Binding Summary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 1 备注 -->
                                    <TextBlock Grid.Row="1"
                                               Margin="0,12,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Note}"
                                               TextWrapping="Wrap" />

                                    <!-- 2 游戏目录 -->
                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="游戏目录" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding GameDir}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GameDir}" />
                                    </StackPanel>

                                    <!-- 3 Mods 目录 -->
                                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="Mods 目录" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding ModsDirectory}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ModsDirectory}" />
                                    </StackPanel>

                                    <!-- 4 启动时间 / 时长 -->
                                    <StackPanel Grid.Row="4" Margin="0,8,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding LastLaunchText}" />
                                        <TextBlock Margin="6,0,6,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Disabled}"
                                                   Text="·" />
                                        <TextBlock FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding PlayTimeText}" />
                                    </StackPanel>

                                    <!-- 5 SMAPI 状态（只读） -->
                                    <TextBlock x:Name="LabSmapiStatus"
                                               Grid.Row="5"
                                               Margin="0,10,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- 6 打开目录 -->
                                    <StackPanel Grid.Row="6"
                                                Margin="0,8,0,0"
                                                Orientation="Horizontal">
                                        <c:OutlineButton Padding="8,4"
                                                         FontSize="11.5"
                                                         Content="打开游戏目录"
                                                         Tone="Plain"
                                                         Tag="{Binding}"
                                                         Click="OnOpenGameDirClick" />
                                        <c:OutlineButton Margin="4,0,0,0"
                                                         Padding="8,4"
                                                         FontSize="11.5"
                                                         Content="打开 Mods 目录"
                                                         Tone="Plain"
                                                         Tag="{Binding}"
                                                         Click="OnOpenModsDirClick" />
                                        <c:OutlineButton Margin="4,0,0,0"
                                                         Padding="8,4"
                                                         FontSize="11.5"
                                                         Content="打开 SMAPI 下载页"
                                                         Tone="Plain"
                                                         Click="OnOpenSmapiPageClick" />
                                    </StackPanel>

                                    <!-- 7 提示信息 -->
                                    <TextBlock x:Name="LabRunWarning"
                                               Grid.Row="7"
                                               Margin="0,8,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Status.Warn}"
                                               TextWrapping="Wrap"
                                               Text="游戏正在运行，修改 Mods 前建议先关闭游戏"
                                               Visibility="Collapsed" />

                                    <!-- 8 底部操作 -->
                                    <Grid Grid.Row="8" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <c:OutlineButton Grid.Column="0"
                                                         Padding="14,6"
                                                         Content="删除"
                                                         FontSize="12.5"
                                                         Tag="{Binding}"
                                                         Tone="Danger"
                                                         Click="OnDeleteInstanceClick" />

                                        <c:OutlineButton x:Name="BtnSwitchKind"
                                                         Grid.Column="1"
                                                         Margin="8,0,0,0"
                                                         Padding="12,6"
                                                         HorizontalAlignment="Left"
                                                         Content="切换为 Mod 端"
                                                         FontSize="12"
                                                         Tag="{Binding}"
                                                         Tone="Outline"
                                                         Click="OnSwitchKindClick" />

                                        <c:OutlineButton Grid.Column="2"
                                                         Padding="14,6"
                                                         Content="使用此实例"
                                                         FontSize="12.5"
                                                         Tag="{Binding}"
                                                         Tone="Outline"
                                                         Click="OnUseInstanceClick"
                                                         Loaded="OnUseButtonLoaded" />
                                    </Grid>
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <c:SurfaceCard x:Name="CardEmpty"
                               Margin="0,4,0,0"
                               Title="没有匹配的实例"
                               UseShadow="False"
                               Visibility="Collapsed">
                    <TextBlock x:Name="LabEmpty"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </c:SurfaceCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</c:LauncherPage>
