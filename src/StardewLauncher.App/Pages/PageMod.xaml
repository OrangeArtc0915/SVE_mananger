<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageMod"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls"
                xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <c:LauncherPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </c:LauncherPage.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 原版实例提示条 -->
        <Border x:Name="BarVanilla"
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12,10"
                Background="{DynamicResource Status.WarnSoft}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <svg:SvgIcon Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/triangle-alert"
                             IconBrush="{DynamicResource Status.Warn}" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap"
                           Text="当前是原版实例，这些 Mod 不会被加载。如需使用 Mod，请新建或切换到 Mod 端实例" />
            </StackPanel>
        </Border>

        <!-- 工具栏：搜索与主操作固定在左，其余按钮自动折行，避免窄窗口下互相重叠 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Width="240"
                        Height="38"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <svg:SvgIcon Grid.Column="0"
                                     Width="15"
                                     Height="15"
                                     VerticalAlignment="Center"
                                     Icon="lucide/search"
                                     IconBrush="{DynamicResource Text.Tertiary}" />

                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>

                <c:OutlineButton Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 Content="从 Mod 库安装"
                                 Tone="Solid"
                                 Click="OnInstallFromLibraryClick" />
            </StackPanel>

            <WrapPanel Grid.Column="1"
                       Margin="8,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center">
                <c:OutlineButton Click="OnInstallSmapiClick">
                    <StackPanel Orientation="Horizontal">
                        <svg:SvgIcon Width="14"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     Icon="lucide/download"
                                     IconBrush="{DynamicResource Accent.Base}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="下载 SMAPI" />
                    </StackPanel>
                </c:OutlineButton>
                <c:OutlineButton Margin="8,0,0,0" Tone="Solid" Click="OnOnlineDownloadClick">
                    <StackPanel Orientation="Horizontal">
                        <svg:SvgIcon Width="14"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     Icon="lucide/download"
                                     IconBrush="{DynamicResource Text.OnAccent}" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="在线下载" />
                    </StackPanel>
                </c:OutlineButton>
                <c:OutlineButton Margin="8,0,0,0" Content="导入 Mod" Click="OnImportClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Content="下载 Mod"
                                 Tone="Solid"
                                 Click="OnDownloadModClick" />
                <c:OutlineButton Margin="8,0,0,0" Content="全部启用" Click="OnEnableAllClick" />
                <c:OutlineButton Margin="8,0,0,0" Content="打开 Mods 目录" Click="OnOpenModsClick" />
                <c:OutlineButton Margin="8,0,0,0" Content="刷新" Click="OnRefreshClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Content="检查更新"
                                 Tone="Solid"
                                 Click="OnCheckUpdateClick" />
            </WrapPanel>
        </Grid>

        <!-- 视图切换 + 标签筛选（多选取并集） -->
        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <c:OutlineButton x:Name="BtnViewAll"
                             Padding="14,5"
                             Content="全部 Mod"
                             FontSize="12.5"
                             Tone="Solid"
                             Click="OnViewAllClick" />
            <c:OutlineButton x:Name="BtnViewDeps"
                             Margin="8,0,0,0"
                             Padding="14,5"
                             Content="依赖问题"
                             FontSize="12.5"
                             Tone="Outline"
                             Click="OnViewDepsClick" />
            <c:OutlineButton x:Name="BtnFillAllDeps"
                             Margin="8,0,0,0"
                             Padding="14,5"
                             Content="一键补齐"
                             FontSize="12.5"
                             Tone="Solid"
                             Visibility="Collapsed"
                             Click="OnFillAllDependenciesClick" />

            <TextBlock Margin="14,0,6,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       Text="标签筛选：" />

            <WrapPanel x:Name="PanTagFilter" VerticalAlignment="Center" />

            <c:OutlineButton x:Name="BtnClearTagFilter"
                             Margin="4,0,0,6"
                             Padding="10,3"
                             Content="清除筛选"
                             FontSize="11.5"
                             Tone="Plain"
                             VerticalAlignment="Center"
                             Visibility="Collapsed"
                             Click="OnClearTagFilterClick" />
        </WrapPanel>

        <!-- 汇总行：数量汇总 + 当前扫描目录 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabSummary"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Secondary}" />

            <TextBlock x:Name="LabPath"
                       Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 依赖提示条与展开列表 -->
        <StackPanel Grid.Row="4">
            <Border x:Name="BarDeps"
                    Margin="0,10,0,0"
                    Padding="12,10"
                    Background="{DynamicResource Status.WarnSoft}"
                    CornerRadius="{StaticResource Radius.Item}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnDepsToggle"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <svg:SvgIcon Width="16"
                                 Height="16"
                                 Margin="0,1,0,0"
                                 VerticalAlignment="Top"
                                 Icon="lucide/triangle-alert"
                                 IconBrush="{DynamicResource Status.Warn}" />
                    <TextBlock x:Name="LabDeps"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <c:SurfaceCard x:Name="CardDepList"
                           Margin="0,8,0,0"
                           Title="依赖问题"
                           UseShadow="False"
                           Visibility="Collapsed">
                <ItemsControl x:Name="PanDepIssues">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,3"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding Text}"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </c:SurfaceCard>
        </StackPanel>

        <!-- 顶部提示条：更新检查占位 / 导入进度 / 批量操作结果 -->
        <Border x:Name="BarNotice"
                Grid.Row="5"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <!-- Mod 列表 / 依赖项表 / 空状态 / 扫描中 -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PanMods">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel Mode="AutoFit"
                                            ColumnGap="14"
                                            ItemWidth="340"
                                            RowGap="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Padding="0" UseShadow="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 状态色条 -->
                                    <Border Grid.Column="0" CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Border.Strong}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                        <Setter Property="Background" Value="{DynamicResource Accent.Base}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                        <Setter Property="Background" Value="{DynamicResource Status.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,12,14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标块 -->
                                            <Border Grid.Column="0"
                                                    Width="38"
                                                    Height="38"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{StaticResource Radius.Small}">
                                                <svg:SvgIcon Width="18"
                                                             Height="18"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Icon="lucide/package"
                                                             IconBrush="{DynamicResource Accent.Base}" />
                                            </Border>

                                            <!-- 名称 / 作者·版本·类型 -->
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                    <TextBlock FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding DisplayAuthor}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="5,0"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Disabled}"
                                                               Text="·" />
                                                    <TextBlock FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding DisplayVersion}" />
                                                    <TextBlock Margin="5,0"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Disabled}"
                                                               Text="·" />
                                                    <TextBlock FontSize="11.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding TypeText}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 状态图标 -->
                                            <svg:SvgIcon Grid.Column="2"
                                                         Width="16"
                                                         Height="16"
                                                         VerticalAlignment="Top">
                                                <svg:SvgIcon.Style>
                                                    <Style TargetType="{x:Type svg:SvgIcon}">
                                                        <Setter Property="Icon" Value="lucide/circle-minus" />
                                                        <Setter Property="IconBrush" Value="{DynamicResource Text.Tertiary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                                <Setter Property="Icon" Value="lucide/circle-check" />
                                                                <Setter Property="IconBrush" Value="{DynamicResource Status.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                                <Setter Property="Icon" Value="lucide/triangle-alert" />
                                                                <Setter Property="IconBrush" Value="{DynamicResource Status.Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </svg:SvgIcon.Style>
                                            </svg:SvgIcon>
                                        </Grid>

                                        <!-- 描述，最多三行 -->
                                        <TextBlock Margin="0,8,0,0"
                                                   MaxHeight="54"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding DisplayDescription}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />

                                        <!-- 已有标签 -->
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding TagChips}"
                                                      Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,4"
                                                            Padding="7,1"
                                                            Background="{Binding Background}"
                                                            CornerRadius="{StaticResource Radius.Pill}">
                                                        <TextBlock FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground}"
                                                                   Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 依赖问题提示 -->
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal"
                                                    ToolTip="{Binding IssuesText}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <svg:SvgIcon Width="14"
                                                         Height="14"
                                                         Margin="0,1,0,0"
                                                         VerticalAlignment="Top"
                                                         Icon="lucide/triangle-alert"
                                                         IconBrush="{DynamicResource Status.Warn}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Status.Warn}"
                                                       Text="有依赖问题" />
                                        </StackPanel>

                                        <!-- 解析失败原因 -->
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Status.Danger}"
                                                   Text="{Binding ParseError}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Invalid">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 操作按钮 -->
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <c:OutlineButton Grid.Column="1"
                                                             Padding="12,5"
                                                             Content="标签"
                                                             FontSize="12.5"
                                                             Tag="{Binding}"
                                                             Tone="Plain"
                                                             Click="OnTagModClick" />
                                            <c:OutlineButton Grid.Column="2"
                                                             Margin="8,0,0,0"
                                                             Padding="12,5"
                                                             Content="禁用"
                                                             FontSize="12.5"
                                                             Tag="{Binding}"
                                                             Tone="Outline"
                                                             Click="OnToggleModClick"
                                                             Loaded="OnToggleModLoaded" />
                                            <c:OutlineButton Grid.Column="3"
                                                             Margin="8,0,0,0"
                                                             Padding="12,5"
                                                             Content="删除"
                                                             FontSize="12.5"
                                                             Tag="{Binding}"
                                                             Tone="Danger"
                                                             Click="OnDeleteModClick" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 依赖项表视图 -->
            <ScrollViewer x:Name="ScrollDeps"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ItemsControl x:Name="PanDepRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,10"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="8,2"
                                            VerticalAlignment="Top"
                                            Background="{Binding KindSoft}"
                                            CornerRadius="{StaticResource Radius.Pill}">
                                        <TextBlock FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding KindBrush}"
                                                   Text="{Binding KindText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding ModName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding IssueText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <c:OutlineButton Grid.Column="2"
                                                     Padding="12,5"
                                                     VerticalAlignment="Center"
                                                     Content="从 Mod 库补齐"
                                                     FontSize="12.5"
                                                     IsEnabled="{Binding CanFill}"
                                                     Tag="{Binding}"
                                                     Tone="Outline"
                                                     Click="OnFillDependencyClick" />
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 无依赖问题 -->
            <c:SurfaceCard x:Name="CardNoDeps"
                           MaxWidth="440"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Title="没有发现依赖问题"
                           UseShadow="False"
                           Visibility="Collapsed">
                <TextBlock FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="当前 Mods 目录里的 Mod 依赖都已满足。"
                           TextWrapping="Wrap" />
            </c:SurfaceCard>

            <!-- 空状态 -->
            <c:SurfaceCard x:Name="CardEmpty"
                           MaxWidth="440"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Title="没有匹配的 Mod"
                           UseShadow="False"
                           Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LabEmpty"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                    <c:OutlineButton x:Name="BtnCreateMods"
                                     Margin="0,12,0,0"
                                     HorizontalAlignment="Left"
                                     Content="创建 Mods 文件夹"
                                     Tone="Solid"
                                     Click="OnCreateModsClick"
                                     Visibility="Collapsed" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 扫描中 -->
            <StackPanel x:Name="PanScanning"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <svg:SvgIcon Width="28"
                             Height="28"
                             HorizontalAlignment="Center"
                             Icon="lucide/refresh-cw"
                             IconBrush="{DynamicResource Text.Tertiary}" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="正在扫描…" />
            </StackPanel>
        </Grid>
    </Grid>
</c:LauncherPage>
