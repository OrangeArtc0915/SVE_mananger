<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageMultiplayer"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls">

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与主操作 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold" Text="联机（樱花FRP）" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="用樱花FRP 把本地 UDP 24642 穿透出去，把连接地址发给朋友，他们在游戏里按局域网联机加入"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnLaunchGame"
                                 Content="去启动游戏"
                                 ToolTip="切到「启动」页，用那里的启动按钮（会先做 Mod 与前置校验）"
                                 Click="OnLaunchGameClick" />
            </StackPanel>
        </Grid>

        <!-- 樱花FRP -->
        <ScrollViewer x:Name="PanSakura"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <c:SurfaceCard Title="账号" UseShadow="False">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="访问密钥" />
                        <Border Height="34"
                                Margin="0,8,0,0"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtSakuraKey"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}" />
                        </Border>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnSakuraVerify"
                                             Padding="12,5"
                                             Content="验证并加载"
                                             FontSize="12.5"
                                             Tone="Solid"
                                             Click="OnSakuraVerifyClick" />
                            <TextBlock x:Name="LabSakuraState"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock x:Name="LabSakuraAccount"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="访问密钥在樱花FRP 管理面板 → 用户信息里复制。它等价于账号密码，只存在本机设置文件里，不会上传。" />
                    </StackPanel>
                </c:SurfaceCard>

                <c:SurfaceCard Margin="0,12,0,0" Title="frpc 客户端" UseShadow="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="LabFrpcState"
                                   Grid.Column="0"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="还没有准备 frpc 客户端。用它才能把本地端口穿透出去。" />

                        <c:OutlineButton x:Name="BtnPrepareFrpc"
                                         Grid.Column="1"
                                         Padding="12,5"
                                         Content="准备 frpc"
                                         FontSize="12.5"
                                         Click="OnPrepareFrpcClick" />
                    </Grid>
                </c:SurfaceCard>

                <c:SurfaceCard Margin="0,12,0,0" Title="我的 UDP 隧道" UseShadow="False">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap"
                                       Text="只有 UDP 隧道能用于星露谷联机。启动后把连接地址发给朋友即可。" />

                            <c:OutlineButton x:Name="BtnRefreshTunnels"
                                             Grid.Column="1"
                                             Padding="12,5"
                                             Content="刷新"
                                             FontSize="12.5"
                                             Click="OnRefreshTunnelsClick" />
                        </Grid>

                        <TextBlock x:Name="LabNoTunnels"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="还没有隧道。先点「验证并加载」，再到下面新建一条。" />

                        <ScrollViewer x:Name="ScrollTunnels"
                                      MaxHeight="150"
                                      Margin="0,4,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="PanTunnels">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock FontSize="12.5"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <c:OutlineButton Grid.Column="1"
                                                             Padding="12,5"
                                                             VerticalAlignment="Center"
                                                             Content="启动"
                                                             FontSize="12.5"
                                                             Tag="{Binding}"
                                                             Tone="Solid"
                                                             Click="OnStartTunnelClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </c:SurfaceCard>

                <c:SurfaceCard Margin="0,12,0,0" Title="新建 UDP 隧道" UseShadow="False">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="隧道名" />
                                <Border Height="34"
                                        Margin="0,8,0,0"
                                        Padding="10,0"
                                        Background="{DynamicResource Surface.Sunken}"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Button}">
                                    <TextBox x:Name="TxtTunnelName"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CaretBrush="{DynamicResource Text.Primary}"
                                             Foreground="{DynamicResource Text.Primary}" />
                                </Border>
                            </StackPanel>

                            <c:OutlineButton x:Name="BtnLoadNodes"
                                             Grid.Column="1"
                                             Margin="0,28,0,0"
                                             Padding="12,5"
                                             Content="加载节点"
                                             FontSize="12.5"
                                             Click="OnLoadNodesClick" />
                        </Grid>

                        <TextBlock x:Name="LabNoNodes"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="点「加载节点」列出可用于星露谷的节点（要求：允许建隧道 + 允许 UDP + 在线）。" />

                        <ScrollViewer x:Name="ScrollSakuraNodes"
                                      MaxHeight="140"
                                      Margin="0,4,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="PanSakuraNodes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <c:OutlineButton Margin="0,0,0,6"
                                                         Padding="12,8"
                                                         HorizontalContentAlignment="Stretch"
                                                         Tag="{Binding}"
                                                         Tone="{Binding Tone}"
                                                         Click="OnSakuraNodeClick">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding Detail}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </c:OutlineButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <c:OutlineButton x:Name="BtnCreateTunnel"
                                         Margin="0,10,0,0"
                                         Padding="12,6"
                                         HorizontalAlignment="Left"
                                         Content="创建 UDP 隧道（本地端口 24642）"
                                         FontSize="12.5"
                                         Tone="Solid"
                                         Click="OnCreateTunnelClick" />
                    </StackPanel>
                </c:SurfaceCard>

                <c:SurfaceCard x:Name="CardTunnelRunning"
                               Margin="0,12,0,0"
                               Title="隧道运行中"
                               UseShadow="False"
                               Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="LabTunnelAddress"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Accent.Base}"
                                   TextWrapping="Wrap"
                                   Text="正在等待连接地址…" />

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="朋友在游戏里：合作 → 加入局域网游戏 → 输入这个地址。原版没有密码保护，不联机时记得停掉隧道。" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnCopyTunnelAddress"
                                             Padding="12,5"
                                             Content="复制地址"
                                             FontSize="12.5"
                                             Click="OnCopyTunnelAddressClick" />
                            <c:OutlineButton x:Name="BtnStopTunnel"
                                             Margin="8,0,0,0"
                                             Padding="12,5"
                                             Content="停止隧道"
                                             FontSize="12.5"
                                             Tone="Danger"
                                             Click="OnStopTunnelClick" />
                        </StackPanel>
                    </StackPanel>
                </c:SurfaceCard>
            </StackPanel>
        </ScrollViewer>

        <!-- 运行日志 -->
        <c:SurfaceCard Grid.Row="2"
                       Margin="0,12,0,0"
                       Title="运行日志"
                       UseShadow="False">
            <Grid>
                <TextBlock x:Name="LabLogEmpty"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有联机记录" />
                <ScrollViewer x:Name="ScrollLog"
                              Height="120"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="PanLogLines" />
                </ScrollViewer>
            </Grid>
        </c:SurfaceCard>
    </Grid>
</c:LauncherPage>
