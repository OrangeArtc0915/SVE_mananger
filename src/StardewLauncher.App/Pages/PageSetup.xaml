<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageSetup"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls">

    <c:LauncherPage.Resources>
        <!-- 色相条：细轨道 + 圆形滑块，用主题画笔保证深浅色下都看得清 -->
        <Style x:Key="AccentHueSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="6"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Sunken}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="3" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="Slider.DecreaseLarge"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Accent.Bright}"
                                                         Stroke="{DynamicResource Surface.Card}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="Transparent"
                                                  BorderThickness="0"
                                                  Command="Slider.IncreaseLarge"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </c:LauncherPage.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,16">
            <TextBlock FontSize="18" FontWeight="Bold" Text="设置" />
            <TextBlock Margin="0,4,0,14"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="界面、存储与游戏相关的选项都在这里" />

            <c:MasonryPanel Mode="Columns"
                            ColumnGap="14"
                            Columns="2"
                            RowGap="14">

                <!-- 1. 外观 -->
                <c:SurfaceCard Title="外观">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="明暗模式" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnThemeLight"
                                             Tag="Light"
                                             Content="浅色"
                                             Click="OnThemeModeClick" />
                            <c:OutlineButton x:Name="BtnThemeDark"
                                             Margin="8,0,0,0"
                                             Tag="Dark"
                                             Content="深色"
                                             Click="OnThemeModeClick" />
                            <c:OutlineButton x:Name="BtnThemeSystem"
                                             Margin="8,0,0,0"
                                             Tag="System"
                                             Content="跟随系统"
                                             Click="OnThemeModeClick" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="强调色" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnAccentStardew"
                                             Tag="Stardew"
                                             Content="星露谷"
                                             Click="OnAccentClick" />
                            <c:OutlineButton x:Name="BtnAccentSky"
                                             Margin="8,0,0,0"
                                             Tag="SkyBlue"
                                             Content="湖蓝"
                                             Click="OnAccentClick" />
                            <c:OutlineButton x:Name="BtnAccentBerry"
                                             Margin="8,0,0,0"
                                             Tag="BerryPink"
                                             Content="莓果"
                                             Click="OnAccentClick" />
                            <c:OutlineButton x:Name="BtnAccentAutumn"
                                             Margin="8,0,0,0"
                                             Tag="Autumn"
                                             Content="秋日"
                                             Click="OnAccentClick" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="色板预览" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource Accent.Deep}"
                                    CornerRadius="6" />
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource Accent.Base}"
                                    CornerRadius="6" />
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource Accent.Bright}"
                                    CornerRadius="6" />
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource Accent.Hover}"
                                    CornerRadius="6" />
                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource Accent.Soft}"
                                    CornerRadius="6" />
                            <Border Width="34"
                                    Height="34"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="6" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="自定义强调色" />
                        <TextBlock x:Name="LabAccentHint"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="拖动下面的色相条即改即看（上面的色板跟着变）；不想要自定义色时点「用预设配色」。" />
                        <Slider x:Name="SldAccentHue"
                                Margin="0,8,0,0"
                                Maximum="359"
                                Minimum="0"
                                KeyUp="OnAccentHueCommitted"
                                LostMouseCapture="OnAccentHueCommitted"
                                Style="{StaticResource AccentHueSlider}"
                                ValueChanged="OnAccentHueChanged" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Border Width="180"
                                    Height="32"
                                    Padding="10,0"
                                    Background="{DynamicResource Surface.Card}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}">
                                <TextBox x:Name="TxtAccentHex"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}" />
                            </Border>
                            <c:OutlineButton x:Name="BtnAccentHex"
                                             Margin="8,0,0,0"
                                             Content="按色值"
                                             Tone="Outline"
                                             Click="OnAccentHexClick" />
                            <c:OutlineButton x:Name="BtnAccentReset"
                                             Margin="8,0,0,0"
                                             Content="用预设配色"
                                             Tone="Plain"
                                             Click="OnAccentResetClick" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="面板不透明度" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnGlassThin"
                                             Tag="60"
                                             Content="更透"
                                             Click="OnPanelOpacityClick" />
                            <c:OutlineButton x:Name="BtnGlassNormal"
                                             Margin="8,0,0,0"
                                             Tag="78"
                                             Content="默认"
                                             Click="OnPanelOpacityClick" />
                            <c:OutlineButton x:Name="BtnGlassThick"
                                             Margin="8,0,0,0"
                                             Tag="90"
                                             Content="更实"
                                             Click="OnPanelOpacityClick" />
                            <c:OutlineButton x:Name="BtnGlassSolid"
                                             Margin="8,0,0,0"
                                             Tag="100"
                                             Content="不透明"
                                             Click="OnPanelOpacityClick" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="只影响侧栏、标题栏与卡片这类半透明面板；数值越大越实，背景图越看不出来。" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 1.5 个性化背景 -->
                <c:SurfaceCard Title="个性化背景">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="窗口背景" />
                        <TextBlock x:Name="LabBackground"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="未设置，使用主题渐变。" />

                        <c:OutlineButton x:Name="BtnPickBackground"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Left"
                                         Content="选择图片或视频"
                                         Tone="Solid"
                                         Click="OnPickBackgroundClick" />

                        <c:OutlineButton x:Name="BtnClearBackground"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="清除背景"
                                         Tone="Danger"
                                         Click="OnClearBackgroundClick" />

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="铺放方式" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnFitCover"
                                             Tag="Cover"
                                             Content="铺满"
                                             Click="OnBackgroundFitClick" />
                            <c:OutlineButton x:Name="BtnFitContain"
                                             Margin="8,0,0,0"
                                             Tag="Contain"
                                             Content="完整"
                                             Click="OnBackgroundFitClick" />
                            <c:OutlineButton x:Name="BtnFitFill"
                                             Margin="8,0,0,0"
                                             Tag="Fill"
                                             Content="拉伸"
                                             Click="OnBackgroundFitClick" />
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="压暗程度" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnDimNone"
                                             Tag="0"
                                             Content="不压"
                                             Click="OnBackgroundDimClick" />
                            <c:OutlineButton x:Name="BtnDimLight"
                                             Margin="8,0,0,0"
                                             Tag="25"
                                             Content="轻"
                                             Click="OnBackgroundDimClick" />
                            <c:OutlineButton x:Name="BtnDimMedium"
                                             Margin="8,0,0,0"
                                             Tag="45"
                                             Content="中"
                                             Click="OnBackgroundDimClick" />
                            <c:OutlineButton x:Name="BtnDimHeavy"
                                             Margin="8,0,0,0"
                                             Tag="65"
                                             Content="重"
                                             Click="OnBackgroundDimClick" />
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="背景铺满整个窗口，界面面板是半透明的。页面标题直接压在背景上，所以建议留着压暗。" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 1.8 侧栏导航 -->
                <c:SurfaceCard Title="侧栏导航">
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="上移 / 下移调整顺序，右边的按钮决定显示还是收起；改完立刻生效。" />

                        <StackPanel x:Name="PanNavItems" Margin="0,10,0,0" />

                        <c:OutlineButton x:Name="BtnNavReset"
                                         Margin="0,12,0,0"
                                         HorizontalAlignment="Left"
                                         Content="恢复默认顺序"
                                         Tone="Plain"
                                         Click="OnNavResetClick" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 2. 游戏与实例 -->
                <c:SurfaceCard Title="游戏与实例">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="当前实例" />
                        <TextBlock x:Name="LabGameInfo"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="游戏目录" />
                        <TextBlock x:Name="LabGameDir"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <c:OutlineButton Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="打开游戏目录"
                                         Click="OnOpenGameDirClick" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="SMAPI" />
                        <TextBlock x:Name="LabSmapiInfo"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="正在查询 SMAPI 最新版本…" />
                        <c:OutlineButton Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="打开 SMAPI 下载页"
                                         Click="OnOpenSmapiPageClick" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="更新检查" />

                        <c:OutlineButton x:Name="BtnCheckLauncherUpdate"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="检查启动器更新"
                                         Tone="Solid"
                                         Click="OnCheckLauncherUpdateClick" />
                        <TextBlock x:Name="LabLauncherUpdate"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="点上面的按钮检查启动器自身有没有新版本。" />

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="启动器更新线路" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnUpdateLineGitHub"
                                             Tag="GitHub"
                                             Content="GitHub"
                                             Click="OnUpdateLineClick" />
                            <c:OutlineButton x:Name="BtnUpdateLineGitee"
                                             Margin="8,0,0,0"
                                             Tag="Gitee"
                                             Content="Gitee"
                                             Click="OnUpdateLineClick" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="只影响启动器自身更新的查版本与下载走哪个源；选的那条取不到时会自动换另一条。改动上面的「下载源」时这里会跟着变。" />

                        <c:OutlineButton x:Name="BtnCheckOnStartup"
                                         Margin="0,10,0,0"
                                         HorizontalAlignment="Left"
                                         Tag="CheckUpdateOnStartup"
                                         Click="OnUpdateToggleClick" />
                        <c:OutlineButton x:Name="BtnModUpdateCheck"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Tag="ModUpdateCheckEnabled"
                                         Click="OnUpdateToggleClick" />
                        <c:OutlineButton x:Name="BtnSmapiUpdateCheck"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Tag="SmapiUpdateCheckEnabled"
                                         Click="OnUpdateToggleClick" />

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="「检查 Mod 更新」开启后，每次进入 Mod 管理页会顺带查一次新版本（结果缓存 6 小时）；随时也可以在那里点「检查更新」立刻重查。只有 manifest.json 里写了 UpdateKeys 的 Mod 才查得到。" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="存档" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="存档默认位于 %appdata%\StardewValley\Saves。若同时开启 Steam 云同步，请避免用其它工具改写同一份存档，以免互相覆盖。" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 3. Mod 与下载 -->
                <c:SurfaceCard Title="Mod 与下载">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="Mod 库目录" />
                        <TextBlock x:Name="LabModLibraryPath"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton Content="选择目录" Click="OnChooseModLibraryClick" />
                            <c:OutlineButton Margin="8,0,0,0"
                                             Content="自动检测"
                                             Click="OnDetectModLibraryClick" />
                            <c:OutlineButton Margin="8,0,0,0"
                                             Content="打开目录"
                                             Click="OnOpenModLibraryClick" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="Mod 库用于存放已解压、待安装的 Mod。Mod 管理页可以从中勾选并批量安装到游戏目录。" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="入库方式" />
                        <c:OutlineButton x:Name="BtnAutoInstall"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Click="OnToggleAutoInstallClick" />
                        <c:OutlineButton x:Name="BtnAutoInstallInstance"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Click="OnToggleAutoInstallInstanceClick" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="开启后，从启动器下载的 Mod 会自动入库并装进当前实例的 Mods 目录；同名 Mod 会先备份。" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="下载源" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnDownloadSourceGitHub"
                                             Tag="GitHub"
                                             Content="GitHub"
                                             Click="OnDownloadSourceClick" />
                            <c:OutlineButton x:Name="BtnDownloadSourceGitee"
                                             Margin="8,0,0,0"
                                             Tag="Gitee"
                                             Content="Gitee"
                                             Click="OnDownloadSourceClick" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="国内网络访问 GitHub 较慢或不通时，请选 Gitee。后续的启动器自更新与文件下载会按此选择走对应源。" />
                        <TextBlock x:Name="LabDownloadSourceUrl"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="OnOpenDownloadSourceClick" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="nxm:// 协议关联" />
                        <c:OutlineButton x:Name="BtnNxmProtocol"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Click="OnToggleNxmProtocolClick" />
                        <TextBlock x:Name="LabNxmProtocolStatus"
                                   Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="开启后，在 Nexus 网页点「Mod Manager Download」会直接拉起本启动器下载。仅写入当前用户注册表，不需要管理员权限，随时可关闭。" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 4. 网络与账号 -->
                <c:SurfaceCard Title="网络与账号">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="Nexus API Key" />
                        <Border Height="34"
                                Margin="0,8,0,0"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtNexusKey"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     TextChanged="OnNexusKeyChanged" />
                        </Border>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnSaveNexusKey"
                                             Content="保存"
                                             Tone="Solid"
                                             Click="OnSaveNexusKeyClick" />
                            <c:OutlineButton x:Name="BtnVerifyNexus"
                                             Margin="8,0,0,0"
                                             Content="验证账号"
                                             Click="OnVerifyNexusClick" />
                        </StackPanel>

                        <TextBlock x:Name="LabNexusKeyHint"
                                   Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="LabNexusAccount"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="Nexus 配额" />
                        <TextBlock x:Name="LabNexusQuota"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="在线下载 Mod" />
                        <c:OutlineButton x:Name="BtnBrowseNexus"
                                         Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="在线下载 Mod"
                                         Tone="Solid"
                                         Click="OnBrowseNexusClick" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="非会员也可下载：在窗口内浏览 Mod 页面，点「Mod Manager Download」，下载会直接在启动器内开始。窗口内登录 Nexus 账号后 Cookie 会保存在程序数据目录，下次无需重复登录。" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="天气与位置" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="城市" />
                        <Border Height="34"
                                Margin="0,6,0,0"
                                Padding="10,0"
                                Background="{DynamicResource Surface.Sunken}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Button}">
                            <TextBox x:Name="TxtWeatherCity"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource Text.Primary}"
                                     Foreground="{DynamicResource Text.Primary}"
                                     TextChanged="OnWeatherCityChanged" />
                        </Border>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton x:Name="BtnSaveWeatherCity"
                                             Content="保存并测试"
                                             Tone="Solid"
                                             Click="OnSaveWeatherCityClick" />
                            <c:OutlineButton x:Name="BtnRefreshWeather"
                                             Margin="8,0,0,0"
                                             Content="刷新天气"
                                             Click="OnRefreshWeatherClick" />
                        </StackPanel>

                        <TextBlock x:Name="LabWeatherStatus"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="天气数据来自 Open-Meteo（免费公开接口，无需密钥）；城市名支持中文，例如「杭州」「北京」。" />
                    </StackPanel>
                </c:SurfaceCard>

                <!-- 5. 存储与日志 -->
                <c:SurfaceCard Title="存储与日志">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="数据目录" />
                        <TextBlock x:Name="LabDataPath"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <c:OutlineButton Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="打开数据目录"
                                         Click="OnOpenDataFolderClick" />

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="下载目录" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   Text="监控浏览器下载的 Mod，便于一键入库" />
                        <TextBlock x:Name="LabDownloadFolder"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <c:OutlineButton Content="选择目录" Click="OnChooseDownloadFolderClick" />
                            <c:OutlineButton Margin="8,0,0,0"
                                             Content="恢复默认"
                                             Click="OnResetDownloadFolderClick" />
                            <c:OutlineButton Margin="8,0,0,0"
                                             Content="打开下载目录"
                                             Click="OnOpenDownloadFolderClick" />
                        </StackPanel>

                        <Border Height="1"
                                Margin="0,12,0,12"
                                Background="{DynamicResource Border.Default}" />

                        <TextBlock FontSize="12" Foreground="{DynamicResource Text.Secondary}" Text="日志目录" />
                        <TextBlock x:Name="LabLogPath"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <c:OutlineButton Margin="0,8,0,0"
                                         HorizontalAlignment="Left"
                                         Content="打开日志目录"
                                         Click="OnOpenLogFolderClick" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="日志会按大小滚动，自动保留最近若干份，便于排查启动与下载问题。" />
                    </StackPanel>
                </c:SurfaceCard>

            </c:MasonryPanel>
        </StackPanel>
    </ScrollViewer>
</c:LauncherPage>
