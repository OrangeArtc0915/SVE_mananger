<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageLaunch"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls"
                xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
                xmlns:views="clr-namespace:StardewLauncher.App.Views">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,10">

            <!-- 欢迎卡 -->
            <c:SurfaceCard Padding="0">
                <Grid ClipToBounds="True">
                    <!-- 星露谷素材：低透明度全景做点缀，压在文字下方不影响可读性 -->
                    <Image x:Name="ImgWelcomePanorama"
                           Height="96"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Opacity="0.24"
                           Source="pack://application:,,,/StardewLauncher;component/Assets/Art/stardew-panorama.png"
                           Stretch="UniformToFill" />

                    <Grid Margin="18,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="72"
                            Height="72"
                            Margin="0,0,18,0"
                            Background="{DynamicResource Accent.Base}"
                            CornerRadius="{StaticResource Radius.Card}">
                        <svg:SvgIcon Icon="lucide/sparkles"
                                     Width="30"
                                     Height="30"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IconBrush="{DynamicResource Text.OnAccent}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LabGreeting"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Margin="0,4,0,10"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="小农场主，今天也要好好种地呀" />
                        <Border HorizontalAlignment="Left"
                                Padding="12,6"
                                Background="{DynamicResource Accent.Bright}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <TextBlock FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.OnAccent}"
                                       Text="今日宜挖矿，宜开心" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="20" Text="🌱" />
                    </StackPanel>
                    </Grid>
                </Grid>
            </c:SurfaceCard>

            <!-- 快捷启动 / 常去小站 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <c:SurfaceCard Grid.Column="0" Title="快捷启动">
                    <StackPanel Margin="18,22,18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LabInstanceName"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="还没有可用实例"
                                       TextTrimming="CharacterEllipsis" />
                            <Border x:Name="BorKind"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LabKind"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LabInstanceSummary"
                                   Margin="0,3,0,10"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="先选择或新建一个实例"
                                   TextWrapping="Wrap" />

                        <c:OutlineButton x:Name="BtnLaunch"
                                         Height="40"
                                         HorizontalAlignment="Stretch"
                                         Click="OnLaunchClick"
                                         Content="▶  启动游戏"
                                         Tone="Solid" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <c:OutlineButton x:Name="BtnSelectInstance"
                                             Grid.Column="0"
                                             Height="32"
                                             Content="选择实例"
                                             Click="OnSelectInstanceClick" />
                            <c:OutlineButton Grid.Column="2" Height="32" Content="实例设置" />
                        </Grid>

                        <!-- 未安装 SMAPI 时的提示条 -->
                        <Border x:Name="PanSmapiWarn"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Status.WarnSoft}"
                                CornerRadius="{StaticResource Radius.Item}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource Status.Warn}"
                                           TextWrapping="Wrap"
                                           Text="还没安装 SMAPI，Mod 不会生效" />
                                <c:OutlineButton Margin="0,6,0,0"
                                                 Padding="10,5"
                                                 HorizontalAlignment="Left"
                                                 FontSize="12"
                                                 Content="去设置页安装"
                                                 Click="OnGoSetupClick" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Item}">
                            <TextBlock FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="启动前会校验当前实例的 Mod 与前置依赖；第一次使用请先到「设置」里确认游戏目录。" />
                        </Border>
                    </StackPanel>
                </c:SurfaceCard>

                <c:SurfaceCard Grid.Column="2" Title="常去小站">
                    <StackPanel Margin="12,22,12,10">
                        <ItemsControl x:Name="PanLinks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9,7"
                                            Cursor="Hand"
                                            Tag="{Binding Url}"
                                            ToolTip="{Binding Url}"
                                            MouseLeftButtonUp="OnLinkClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Common.Transparent}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <svg:SvgIcon Grid.Column="0"
                                                         Width="15"
                                                         Height="15"
                                                         VerticalAlignment="Center"
                                                         Icon="{Binding Icon}"
                                                         IconBrush="{DynamicResource Accent.Base}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <svg:SvgIcon Grid.Column="2"
                                                         Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/external-link"
                                                         IconBrush="{DynamicResource Text.Tertiary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:SurfaceCard>
            </Grid>

            <!-- 日历 / 每日一言 -->
            <views:HomepageWidgetsView x:Name="PanWidgets" Margin="0,12,0,0" />

            <!-- 启动日志 -->
            <c:SurfaceCard Margin="0,12,0,0" Title="启动日志" UseShadow="False">
                <Grid Margin="18,16,18,16">
                    <TextBlock x:Name="LabLogEmpty"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Text="还没有启动记录" />
                    <ScrollViewer x:Name="ScrollLog"
                                  Height="180"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="PanLogLines" />
                    </ScrollViewer>
                </Grid>
            </c:SurfaceCard>
        </StackPanel>
    </ScrollViewer>
</c:LauncherPage>
