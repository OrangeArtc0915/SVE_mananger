<c:LauncherPage x:Class="StardewLauncher.App.Pages.PageLaunch"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:c="clr-namespace:StardewLauncher.App.Controls"
                xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
                xmlns:views="clr-namespace:StardewLauncher.App.Views">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,10">

            <!--
                欢迎卡：左边问候语，右边整张全景图。
                全景图是 640x400（1.6:1），内容区做 140 高时它渲染成 224x140 ——
                用 Uniform 才是「完整显示、不裁切、不变形」，换任何比例的图都不会出问题。
                之前用 UniformToFill 在这种扁框里铺满，必然要先把图放大再裁掉大半，怎么调都难看。
            -->
            <c:SurfaceCard Padding="0">
                <Grid Margin="20,18,20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标方块：直接用程序自己的图标，和标题栏、任务栏保持一致 -->
                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            Margin="0,0,18,0"
                            ClipToBounds="True"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource Radius.Card}">
                        <Image Width="64"
                               Height="64"
                               Source="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
                               Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,20,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="LabGreeting"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="小农场主，今天也要好好种地呀" />

                        <!-- 今日宜：淡底 + 强调色字，别抢问候语的视觉重心 -->
                        <Border Margin="0,12,0,0"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <TextBlock FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Base}"
                                       Text="今日宜挖矿，宜开心" />
                        </Border>
                    </StackPanel>

                    <!--
                        全景图整张显示，不裁切也不拉伸。
                        圆角靠 Border 的背景裁切实现：Border 的 Background 会被裁进圆角里，
                        不用再套一层 OpacityMask（上一版套了，反而把图切成了半张）。
                    -->
                    <Border Grid.Column="2"
                            Width="240"
                            Height="140"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource Radius.Card}">
                        <Border.Background>
                            <ImageBrush x:Name="BrushPanorama"
                                        AlignmentX="Center"
                                        AlignmentY="Center"
                                        ImageSource="pack://application:,,,/StardewLauncher;component/Assets/Art/stardew-panorama.png"
                                        Stretch="Uniform" />
                        </Border.Background>
                    </Border>
                </Grid>
            </c:SurfaceCard>

            <!-- 快捷启动 / 常去小站 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <c:SurfaceCard Grid.Column="0" Title="快捷启动">
                    <StackPanel Margin="18,22,18,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LabInstanceName"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="还没有可用实例"
                                       TextTrimming="CharacterEllipsis" />
                            <Border x:Name="BorKind"
                                    Margin="8,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Accent.Faint}"
                                    CornerRadius="{StaticResource Radius.Pill}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LabKind"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent.Base}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LabInstanceSummary"
                                   Margin="0,3,0,10"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="先选择或新建一个实例"
                                   TextWrapping="Wrap" />

                        <c:OutlineButton x:Name="BtnLaunch"
                                         Height="40"
                                         HorizontalAlignment="Stretch"
                                         Click="OnLaunchClick"
                                         Content="▶  启动游戏"
                                         Tone="Solid" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <c:OutlineButton x:Name="BtnSelectInstance"
                                             Grid.Column="0"
                                             Height="32"
                                             Content="选择实例"
                                             Click="OnSelectInstanceClick" />
                            <c:OutlineButton Grid.Column="2" Height="32" Content="实例设置" />
                        </Grid>

                        <!-- 未安装 SMAPI 时的提示条 -->
                        <Border x:Name="PanSmapiWarn"
                                Margin="0,10,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Status.WarnSoft}"
                                CornerRadius="{StaticResource Radius.Item}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontSize="11.5"
                                           Foreground="{DynamicResource Status.Warn}"
                                           TextWrapping="Wrap"
                                           Text="还没安装 SMAPI，Mod 不会生效" />
                                <c:OutlineButton Margin="0,6,0,0"
                                                 Padding="10,5"
                                                 HorizontalAlignment="Left"
                                                 FontSize="12"
                                                 Content="去设置页安装"
                                                 Click="OnGoSetupClick" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,10,0,0"
                                Padding="10,8"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Item}">
                            <TextBlock FontSize="11.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="启动前会校验当前实例的 Mod 与前置依赖；第一次使用请先到「设置」里确认游戏目录。" />
                        </Border>
                    </StackPanel>
                </c:SurfaceCard>

                <c:SurfaceCard Grid.Column="2" Title="常去小站">
                    <StackPanel Margin="12,22,12,10">
                        <ItemsControl x:Name="PanLinks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9,7"
                                            Cursor="Hand"
                                            Tag="{Binding Url}"
                                            ToolTip="{Binding Url}"
                                            MouseLeftButtonUp="OnLinkClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Common.Transparent}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <svg:SvgIcon Grid.Column="0"
                                                         Width="15"
                                                         Height="15"
                                                         VerticalAlignment="Center"
                                                         Icon="{Binding Icon}"
                                                         IconBrush="{DynamicResource Accent.Base}" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0,10,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <svg:SvgIcon Grid.Column="2"
                                                         Width="12"
                                                         Height="12"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/external-link"
                                                         IconBrush="{DynamicResource Text.Tertiary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:SurfaceCard>
            </Grid>

            <!-- 日历 / 每日一言 -->
            <views:HomepageWidgetsView x:Name="PanWidgets" Margin="0,12,0,0" />

            <!-- 启动日志 -->
            <c:SurfaceCard Margin="0,12,0,0" Title="启动日志" UseShadow="False">
                <Grid Margin="18,16,18,16">
                    <TextBlock x:Name="LabLogEmpty"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Text="还没有启动记录" />
                    <ScrollViewer x:Name="ScrollLog"
                                  Height="180"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="PanLogLines" />
                    </ScrollViewer>
                </Grid>
            </c:SurfaceCard>
        </StackPanel>
    </ScrollViewer>
</c:LauncherPage>
