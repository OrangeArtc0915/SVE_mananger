<Window x:Class="StardewLauncher.App.Windows.ModLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="从 Mod 库安装"
        Width="820"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 库目录 + 重新扫描 -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock FontSize="16" FontWeight="Bold" Text="从 Mod 库安装" />
                <TextBlock x:Name="LabLibraryPath"
                           Margin="0,4,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <c:OutlineButton HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Content="重新扫描"
                             Click="OnRescanClick" />
        </Grid>

        <!-- 工具栏：搜索 + 全选 / 全不选 / 只显示未安装 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Border Width="220"
                    Height="36"
                    Padding="12,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <svg:SvgIcon Grid.Column="0"
                                 Width="14"
                                 Height="14"
                                 VerticalAlignment="Center"
                                 Icon="lucide/search"
                                 IconBrush="{DynamicResource Text.Tertiary}" />

                    <TextBox x:Name="TxtSearch"
                             Grid.Column="1"
                             Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Foreground="{DynamicResource Text.Primary}"
                             TextChanged="OnSearchChanged" />
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <c:OutlineButton Content="全选" Click="OnSelectAllClick" />
                <c:OutlineButton Margin="8,0,0,0" Content="全不选" Click="OnSelectNoneClick" />
                <c:OutlineButton x:Name="BtnOnlyUninstalled"
                                 Margin="8,0,0,0"
                                 Click="OnToggleOnlyUninstalledClick" />
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PanMods">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel Mode="AutoFit"
                                            ColumnGap="12"
                                            ItemWidth="330"
                                            RowGap="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Padding="0" UseShadow="False" HasHoverEffect="False">
                                <CheckBox Padding="12,10,12,12"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Top"
                                          Foreground="{DynamicResource Text.Primary}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="6,1"
                                                    Background="{DynamicResource Accent.Faint}"
                                                    CornerRadius="{StaticResource Radius.Pill}"
                                                    Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent.Base}"
                                                           Text="{Binding Category}" />
                                            </Border>
                                            <Border Margin="6,0,0,0"
                                                    Padding="6,1"
                                                    Background="{DynamicResource Surface.Sunken}"
                                                    CornerRadius="{StaticResource Radius.Pill}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="已安装" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding MetaText}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Status.Danger}"
                                                   Text="{Binding ParseError}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasParseError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </CheckBox>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空状态 -->
            <TextBlock x:Name="LabEmpty"
                       MaxWidth="520"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- 扫描中 -->
            <StackPanel x:Name="PanScanning"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <svg:SvgIcon Width="26"
                             Height="26"
                             HorizontalAlignment="Center"
                             Icon="lucide/refresh-cw"
                             IconBrush="{DynamicResource Text.Tertiary}" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="正在扫描 Mod 库…" />
            </StackPanel>
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="LabSelected"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="已选 0 个" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <c:OutlineButton Width="88"
                                 Height="36"
                                 Content="取消"
                                 Tone="Outline"
                                 Click="OnCancelClick" />
                <c:OutlineButton x:Name="BtnInstall"
                                 Width="110"
                                 Height="36"
                                 Margin="10,0,0,0"
                                 Content="安装选中"
                                 IsEnabled="False"
                                 Tone="Solid"
                                 Click="OnInstallClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
