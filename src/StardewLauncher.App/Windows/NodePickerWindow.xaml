<Window x:Class="StardewLauncher.App.Windows.NodePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="选择节点"
        Width="640"
        Height="600"
        MinWidth="540"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="选择节点" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="房间里所有人必须用同一个节点才能互连。延迟只作横向参考：有些节点只放通 UDP，测出来是「不可达」但实际能用。" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,0"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnRetest"
                             Padding="12,6"
                             Content="全部重测"
                             FontSize="12.5"
                             Click="OnRetestClick" />
            <TextBlock x:Name="LabTestState"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PanNodes" />
        </ScrollViewer>

        <c:SurfaceCard Grid.Row="3"
                       Margin="0,12,0,0"
                       Title="自定义节点"
                       UseShadow="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="300"
                            Height="34"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Surface.Sunken}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Button}">
                        <TextBox x:Name="TxtCustom"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="{DynamicResource Text.Primary}"
                                 Foreground="{DynamicResource Text.Primary}" />
                    </Border>
                    <c:OutlineButton x:Name="BtnAdd"
                                     Margin="8,0,0,0"
                                     Padding="12,6"
                                     Content="添加"
                                     FontSize="12.5"
                                     Tone="Solid"
                                     Click="OnAddCustomClick" />
                    <c:OutlineButton x:Name="BtnRemove"
                                     Margin="8,0,0,0"
                                     Padding="12,6"
                                     Content="删除选中"
                                     FontSize="12.5"
                                     Click="OnRemoveCustomClick" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="格式示例：udp://1.2.3.4:11010 或 tcp://1.2.3.4:11010。内置节点不能删除，删除选中只作用于自定义节点。" />
            </StackPanel>
        </c:SurfaceCard>

        <StackPanel Grid.Row="4"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnApply"
                             Content="应用选中节点"
                             Tone="Solid"
                             Click="OnApplyClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="取消"
                             Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
