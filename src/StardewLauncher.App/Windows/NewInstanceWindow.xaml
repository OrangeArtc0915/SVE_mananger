<Window x:Class="StardewLauncher.App.Windows.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="新建实例"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <c:SurfaceCard Margin="16" Padding="0" Title="新建实例" UseShadow="False">
        <StackPanel Margin="16,12,16,16">

            <!-- 实例类型 -->
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="实例类型" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <c:OutlineButton x:Name="BtnKindVanilla"
                                 Grid.Column="0"
                                 Padding="12,8"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Click="OnKindVanillaClick">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="原版" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="直接启动游戏主程序，不加载任何 Mod，也不改动 Mods 目录" />
                    </StackPanel>
                </c:OutlineButton>

                <c:OutlineButton x:Name="BtnKindModded"
                                 Grid.Column="2"
                                 Padding="12,8"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Click="OnKindModdedClick">
                    <StackPanel>
                        <TextBlock FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   Text="Mod 端" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap"
                                   Text="通过 SMAPI 启动，可以加载 Mod" />
                    </StackPanel>
                </c:OutlineButton>
            </Grid>

            <!-- 游戏目录 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="游戏目录" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="38"
                        Padding="10,0"
                        Background="{DynamicResource Surface.Card}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                    <TextBox x:Name="TxtGameDir"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Foreground="{DynamicResource Text.Primary}"
                             TextChanged="OnGameDirChanged" />
                </Border>

                <c:OutlineButton Grid.Column="2"
                                 Height="38"
                                 Padding="14,0"
                                 Content="浏览…"
                                 Click="OnBrowseClick" />
                <c:OutlineButton Grid.Column="4"
                                 Height="38"
                                 Padding="14,0"
                                 Content="自动检测"
                                 Click="OnDetectClick" />
            </Grid>

            <TextBlock x:Name="LabDirState"
                       Margin="0,6,0,0"
                       FontSize="11.5"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="LabSmapiHint"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="该目录未安装 SMAPI，Mod 端需要先在实例页安装 SMAPI" />

            <!-- 自动检测候选 -->
            <StackPanel x:Name="PanCandidates"
                        Margin="0,6,0,0"
                        Visibility="Collapsed" />

            <!-- 实例名称 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="实例名称" />
            <Border Height="38"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <TextBox x:Name="TxtName"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}"
                         Text="我的实例" />
            </Border>

            <!-- 备注 -->
            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="备注" />
            <Border Height="38"
                    Margin="0,6,0,0"
                    Padding="10,0"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <TextBox x:Name="TxtNote"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}" />
            </Border>

            <StackPanel Margin="0,20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <c:OutlineButton Width="88"
                                 Height="36"
                                 Content="取消"
                                 Tone="Outline"
                                 Click="OnCancelClick" />
                <c:OutlineButton x:Name="BtnCreate"
                                 Width="88"
                                 Height="36"
                                 Margin="10,0,0,0"
                                 Content="创建"
                                 IsEnabled="False"
                                 Tone="Solid"
                                 Click="OnCreateClick" />
            </StackPanel>
        </StackPanel>
    </c:SurfaceCard>
</Window>
