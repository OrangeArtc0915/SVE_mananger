<Window x:Class="StardewLauncher.App.Windows.NexusBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="在线下载 Mod"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closed="OnWindowClosed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface.Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：后退 / 前进 / 刷新 -->
            <StackPanel Grid.Column="0"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <c:RoundIconButton x:Name="BtnBack"
                                   Icon="lucide/arrow-left"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="后退"
                                   Click="OnBackClick" />
                <c:RoundIconButton x:Name="BtnForward"
                                   Margin="2,0,0,0"
                                   Icon="lucide/arrow-right"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="前进"
                                   Click="OnForwardClick" />
                <c:RoundIconButton x:Name="BtnRefresh"
                                   Margin="2,0,0,0"
                                   Icon="lucide/refresh-cw"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="刷新"
                                   Click="OnRefreshClick" />
            </StackPanel>

            <!-- 中：当前地址（只读） -->
            <Border Grid.Column="1"
                    Height="30"
                    Margin="10,0"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBlock x:Name="LabAddress"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 右：Key 状态 + 外部按钮 -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock x:Name="LabKeyState"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="11.5" />
                <c:OutlineButton Padding="12,6"
                                 Content="打开系统浏览器"
                                 FontSize="12.5"
                                 Click="OnOpenSystemBrowserClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Padding="12,6"
                                 Content="Mod 库"
                                 FontSize="12.5"
                                 Click="OnOpenLibraryClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Border.Default}" />

        <!-- 站点切换栏：左侧按官方 Wiki「寻找 Mod」清单排列站点按钮（窄窗口自动换行），右侧是 Nexus 一键下载提示 -->
        <Grid Grid.Row="2" Background="{DynamicResource Surface.Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel x:Name="PanSites"
                       Grid.Column="0"
                       Margin="10,5,0,5"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Margin="10,6,12,6"
                       MaxWidth="300"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextWrapping="Wrap"
                       Text="在 Nexus 页面点『Mod Manager Download』可直接在启动器内下载" />
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource Border.Default}" />

        <!-- 内容区：内嵌浏览器；初始化失败时用提示卡覆盖 -->
        <Grid Grid.Row="4">
            <wv2:WebView2 x:Name="Browser" />

            <Border x:Name="PanError"
                    Background="{DynamicResource Surface.Window}"
                    Visibility="Collapsed">
                <c:SurfaceCard MaxWidth="560"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Title="内嵌浏览器不可用"
                               UseShadow="False">
                    <StackPanel>
                        <TextBlock x:Name="LabError"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="仍然可以点下面的按钮用系统浏览器打开当前站点：浏览 Mod 页面后点「Mod Manager Download」，若已在设置页开启 nxm:// 协议关联，下载会由本程序接管。" />
                        <c:OutlineButton Margin="0,12,0,0"
                                         HorizontalAlignment="Left"
                                         Content="用系统浏览器打开当前站点"
                                         Tone="Solid"
                                         Click="OnOpenSystemBrowserClick" />
                    </StackPanel>
                </c:SurfaceCard>
            </Border>
        </Grid>
    </Grid>
</Window>
