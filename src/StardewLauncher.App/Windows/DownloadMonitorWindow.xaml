<w:LauncherWindow x:Class="StardewLauncher.App.Windows.DownloadMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="下载监视器"
        Width="720"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- 子任务行（缩进显示）。分组任务的 Children 一律用它，不再往下递归。
             外面套一层无名容器，是为了让触发器能按名字去折「Row」，避开「触发器够不到模板根元素」的坑。 -->
        <DataTemplate x:Key="ChildTaskTemplate">
            <StackPanel>
                <Border x:Name="Row"
                        Margin="0,0,0,6"
                        Padding="12,9"
                        Background="{DynamicResource Surface.Sunken}"
                        CornerRadius="{StaticResource Radius.Item}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock FontSize="12"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="RowMessage"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       Text="{Binding StateMessage}"
                                       TextWrapping="Wrap" />

                            <Grid x:Name="ProgressArea" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Grid.Column="0"
                                             Height="6"
                                             VerticalAlignment="Center"
                                             Maximum="1"
                                             Minimum="0"
                                             Value="{Binding Progress}" />

                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding Progress, StringFormat={}{0:P0}}" />
                            </Grid>
                        </StackPanel>

                        <c:OutlineButton x:Name="BtnCancel"
                                         Grid.Column="1"
                                         Height="28"
                                         Padding="10,0"
                                         VerticalAlignment="Center"
                                         Content="取消"
                                         Tone="Plain"
                                         Command="{Binding CancelCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Success">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Canceled">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SupportProgress}" Value="False">
                    <Setter TargetName="ProgressArea" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SupportCancel}" Value="False">
                    <Setter TargetName="BtnCancel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateMessage}" Value="">
                    <Setter TargetName="RowMessage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 顶层任务行：卡片 + 分组任务的子任务列表。已结束的整行折起来，界面只留进行中。 -->
        <DataTemplate x:Key="ActiveTaskTemplate">
            <StackPanel>
                <c:SurfaceCard x:Name="Row"
                               Margin="0,0,0,8"
                               Padding="0"
                               HasHoverEffect="False"
                               UseShadow="False">
                    <StackPanel Margin="14,12,14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <svg:SvgIcon Width="15"
                                                 Height="15"
                                                 VerticalAlignment="Center"
                                                 Icon="lucide/download"
                                                 IconBrush="{DynamicResource Accent.Base}" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock x:Name="RowMessage"
                                           Margin="0,4,0,0"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding StateMessage}"
                                           TextWrapping="Wrap" />

                                <Grid x:Name="ProgressArea" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ProgressBar Grid.Column="0"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 Maximum="1"
                                                 Minimum="0"
                                                 Value="{Binding Progress}" />

                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Progress, StringFormat={}{0:P0}}" />
                                </Grid>
                            </StackPanel>

                            <c:OutlineButton x:Name="BtnCancel"
                                             Grid.Column="1"
                                             Height="30"
                                             Padding="12,0"
                                             VerticalAlignment="Center"
                                             Content="取消"
                                             Tone="Plain"
                                             Command="{Binding CancelCommand}" />
                        </Grid>

                        <ItemsControl x:Name="ChildList"
                                      Margin="8,10,0,0"
                                      ItemTemplate="{StaticResource ChildTaskTemplate}"
                                      ItemsSource="{Binding Children}" />
                    </StackPanel>
                </c:SurfaceCard>
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Success">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Canceled">
                    <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SupportProgress}" Value="False">
                    <Setter TargetName="ProgressArea" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SupportCancel}" Value="False">
                    <Setter TargetName="BtnCancel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateMessage}" Value="">
                    <Setter TargetName="RowMessage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="False">
                    <Setter TargetName="ChildList" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="下载监视器" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="这里汇总启动器里正在进行的下载、安装、更新、解压等任务；任务一结束就会记到下面的历史里。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 进行中：标题 + 操作 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}"
                       Text="进行中" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <c:OutlineButton Height="30"
                                 Padding="12,0"
                                 Content="全部取消"
                                 Tone="Outline"
                                 Click="OnCancelAllClick" />
                <c:OutlineButton Height="30"
                                 Margin="8,0,0,0"
                                 Padding="12,0"
                                 Content="清除已结束"
                                 Tone="Plain"
                                 Click="OnClearFinishedClick" />
            </StackPanel>
        </Grid>

        <!-- 进行中列表 -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LabActiveEmpty"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="当前没有正在进行的任务。下载、安装、更新、解压等任务开始后会自动出现在这里。"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="PanActive" ItemTemplate="{StaticResource ActiveTaskTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 历史：标题 + 清空 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Text.Primary}"
                       Text="历史" />

            <c:OutlineButton HorizontalAlignment="Right"
                             Height="30"
                             Padding="12,0"
                             Content="清空历史"
                             Tone="Plain"
                             Click="OnClearHistoryClick" />
        </Grid>

        <!-- 历史列表 -->
        <ScrollViewer Grid.Row="4"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LabHistoryEmpty"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有历史记录。任务结束后会在这里留下一条，最多保留最近的一批。"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="PanHistory">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,8"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="14,11,14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="Chip"
                                            Grid.Column="0"
                                            Padding="7,2"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Accent.Faint}"
                                            CornerRadius="{StaticResource Radius.Pill}">
                                        <TextBlock x:Name="ChipText"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Accent.Base}"
                                                   Text="{Binding StateText}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock x:Name="RowMessage"
                                                   Margin="0,4,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Text.Tertiary}">
                                            <Run Text="{Binding FinishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                            <Run Text=" · 耗时 " />
                                            <Run Text="{Binding DurationSeconds, StringFormat={}{0:0.0}}" />
                                            <Run Text=" 秒" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </c:SurfaceCard>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter TargetName="RowMessage" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateText}" Value="失败">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Status.DangerSoft}" />
                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Status.Danger}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StateText}" Value="已取消">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Surface.Sunken}" />
                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部 -->
        <StackPanel Grid.Row="5"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton Width="88"
                             Height="36"
                             Content="完成"
                             Tone="Solid"
                             Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</w:LauncherWindow>
