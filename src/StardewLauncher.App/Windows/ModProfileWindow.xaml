<w:LauncherWindow x:Class="StardewLauncher.App.Windows.ModProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="Mod 配置档"
        Width="880"
        Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 当前 Mods 目录 + 保存当前状态 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="16" FontWeight="Bold" Text="Mod 配置档" />
                <TextBlock x:Name="LabPath"
                           Margin="0,4,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <c:OutlineButton Content="导入配置档…"
                                 Tone="Outline"
                                 Click="OnImportClick" />
                <c:OutlineButton x:Name="BtnSaveCurrent"
                                 Margin="8,0,0,0"
                                 Content="保存当前状态"
                                 Tone="Solid"
                                 Click="OnSaveCurrentClick" />
            </StackPanel>
        </Grid>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 配置档列表 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PanProfiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:MasonryPanel Mode="AutoFit"
                                            ColumnGap="12"
                                            ItemWidth="330"
                                            RowGap="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Padding="0" UseShadow="False" HasHoverEffect="False">
                                <Grid Margin="14,12,14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding MetaText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2"
                                               Margin="0,2,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding TimeText}" />

                                    <TextBlock Grid.Row="3"
                                               Margin="0,4,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding Note}"
                                               TextWrapping="Wrap" />

                                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <c:OutlineButton Content="应用"
                                                             Tag="{Binding}"
                                                             Tone="Solid"
                                                             Click="OnApplyClick" />
                                            <c:OutlineButton Margin="8,0,0,0"
                                                             Content="用当前状态覆盖"
                                                             Tag="{Binding}"
                                                             Tone="Outline"
                                                             Click="OnOverwriteClick" />
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <c:OutlineButton Content="重命名"
                                                             Tag="{Binding}"
                                                             Tone="Plain"
                                                             Click="OnRenameClick" />
                                            <c:OutlineButton Margin="8,0,0,0"
                                                             Content="导出"
                                                             Tag="{Binding}"
                                                             Tone="Plain"
                                                             Click="OnExportClick" />
                                            <c:OutlineButton Margin="8,0,0,0"
                                                             Content="删除"
                                                             Tag="{Binding}"
                                                             Tone="Danger"
                                                             Click="OnDeleteClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="LabEmpty"
                       MaxWidth="520"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       Text="配置档只记录启停状态，不动 Mod 文件；应用后建议重开游戏。" />

            <c:OutlineButton HorizontalAlignment="Right"
                             Content="关闭"
                             Click="OnCloseClick" />
        </Grid>
    </Grid>
</w:LauncherWindow>
