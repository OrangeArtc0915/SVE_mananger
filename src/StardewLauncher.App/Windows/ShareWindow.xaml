<Window x:Class="StardewLauncher.App.Windows.ShareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="分享给队友"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <StackPanel Margin="16">
        <TextBlock FontSize="16" FontWeight="Bold" Text="分享给队友" />
        <TextBlock Margin="0,6,0,0"
                   FontSize="11.5"
                   Foreground="{DynamicResource Text.Tertiary}"
                   TextWrapping="Wrap"
                   Text="把下面的文本发给队友（微信 / QQ 都行）。他们复制这段文本后，在联机大厅点「一键加入」，房间名、密码、节点会自动填好。" />

        <c:SurfaceCard Margin="0,12,0,0" Title="组网分享文本" UseShadow="False">
            <TextBox x:Name="TxtShare"
                     Height="176"
                     Padding="0"
                     AcceptsReturn="True"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="12.5"
                     Foreground="{DynamicResource Text.Primary}"
                     HorizontalScrollBarVisibility="Disabled"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </c:SurfaceCard>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabStatus"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Status.Success}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnCopy"
                                 Content="复制到剪贴板"
                                 Tone="Solid"
                                 Click="OnCopyClick" />
                <c:OutlineButton Margin="8,0,0,0"
                                 Content="关闭"
                                 Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
