<w:LauncherWindow x:Class="StardewLauncher.App.Windows.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="输入"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabTitle"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="Bold"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="LabLabel"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap" />

            <Border Margin="0,8,0,0"
                    Height="36"
                    Padding="12,0"
                    Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <TextBox x:Name="TxtInput"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Text.Primary}"
                         Foreground="{DynamicResource Text.Primary}" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton Content="取消"
                             IsCancel="True"
                             Tone="Plain"
                             Click="OnCancelClick" />
            <c:OutlineButton Margin="8,0,0,0"
                             Content="确定"
                             IsDefault="True"
                             Tone="Solid"
                             Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</w:LauncherWindow>
