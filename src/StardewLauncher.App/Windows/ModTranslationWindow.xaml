<w:LauncherWindow x:Class="StardewLauncher.App.Windows.ModTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="Mod 翻译"
        Width="840"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <w:LauncherWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </w:LauncherWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Mod 翻译" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="把 Mod 的名称与描述翻成中文记到启动器里，只改这里的显示，不动 Mod 自己的任何文件。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 当前服务商与说明 -->
        <c:SurfaceCard Grid.Row="1"
                       Margin="0,12,0,0"
                       Padding="0"
                       HasHoverEffect="False"
                       UseShadow="False">
            <Grid Margin="16,12,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon Grid.Column="0"
                             Width="20"
                             Height="20"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/globe"
                             IconBrush="{DynamicResource Accent.Base}" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="LabProvider"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="服务商与密钥在「设置」页的「网络与账号」分类里填写。密钥只以加密形式保存在本机，不会写进日志。" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextWrapping="Wrap"
                               Text="描述过长时只取前 400 个字符翻译；翻好的结果会缓存起来，重复翻译不再请求。" />
                </StackPanel>
            </Grid>
        </c:SurfaceCard>

        <!-- 工具栏 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="LabBusy"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Accent.Base}"
                       Text="正在翻译…"
                       Visibility="Collapsed" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnTranslateAll"
                                 Content="翻译全部未翻译的"
                                 Tone="Solid"
                                 Click="OnTranslateAllClick" />
                <c:OutlineButton x:Name="BtnRefresh"
                                 Margin="8,0,0,0"
                                 Content="重新扫描"
                                 Tone="Outline"
                                 Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="3"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <!-- Mod 列表 -->
        <ScrollViewer Grid.Row="4"
                      Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LabEmpty"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <ItemsControl x:Name="PanMods">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,10"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="16,13,16,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgIcon Width="16"
                                                         Height="16"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/package"
                                                         IconBrush="{DynamicResource Accent.Base}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding NameLine}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding SourceDescription}"
                                                   TextWrapping="Wrap" />

                                        <!-- 译文区块 -->
                                        <Border Margin="0,8,0,0"
                                                Padding="10,8"
                                                Background="{DynamicResource Accent.Faint}"
                                                CornerRadius="{StaticResource Radius.Item}"
                                                Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <svg:SvgIcon Width="13"
                                                                 Height="13"
                                                                 VerticalAlignment="Center"
                                                                 Icon="lucide/sparkles"
                                                                 IconBrush="{DynamicResource Accent.Base}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Accent.Base}"
                                                               Text="译文" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Text.Tertiary}"
                                                               Text="{Binding TranslatedAtText}" />
                                                </StackPanel>

                                                <TextBlock Margin="0,6,0,0"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding TranslationName}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding TranslationDescription}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <c:OutlineButton Padding="12,5"
                                                         Content="翻译这个"
                                                         FontSize="12.5"
                                                         IsEnabled="{Binding CanTranslate}"
                                                         Tag="{Binding}"
                                                         Tone="Outline"
                                                         Click="OnTranslateOneClick" />
                                        <c:OutlineButton Margin="0,8,0,0"
                                                         Padding="12,5"
                                                         Content="复制译文"
                                                         FontSize="12.5"
                                                         Tag="{Binding}"
                                                         Tone="Plain"
                                                         Click="OnCopyClick"
                                                         Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <c:OutlineButton x:Name="BtnClearAll"
                             Grid.Column="0"
                             HorizontalAlignment="Left"
                             Content="清空所有翻译"
                             Tone="Danger"
                             Click="OnClearAllClick" />

            <c:OutlineButton Grid.Column="1"
                             Width="88"
                             Height="36"
                             Content="完成"
                             Tone="Solid"
                             Click="OnCloseClick" />
        </Grid>
    </Grid>
</w:LauncherWindow>
