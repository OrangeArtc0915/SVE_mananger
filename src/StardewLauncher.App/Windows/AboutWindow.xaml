<Window x:Class="StardewLauncher.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:core="clr-namespace:StardewLauncher.Core.App;assembly=StardewLauncher.Core"
        Title="关于"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:SurfaceCard Grid.Row="0" Title="关于">
            <StackPanel>
                <!-- 应用标识 -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            ClipToBounds="True"
                            CornerRadius="{StaticResource Radius.Item}">
                        <Image Width="48"
                               Height="48"
                               Source="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="{x:Static core:AppInfo.Name}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{x:Static core:AppInfo.VersionDisplay}" />
                    </StackPanel>
                </StackPanel>

                <!-- 作者 -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="作者" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{x:Static core:AppInfo.Author}" />
                </Grid>

                <!-- GitHub 仓库 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="GitHub 仓库" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Accent.Base}"
                               Cursor="Hand"
                               Text="{x:Static core:AppInfo.GitHubUrl}"
                               ToolTip="{x:Static core:AppInfo.GitHubUrl}"
                               MouseLeftButtonUp="OnOpenGitHubClick" />
                </Grid>

                <!-- Gitee 文件库 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="Gitee 文件库" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Accent.Base}"
                               Cursor="Hand"
                               Text="{x:Static core:AppInfo.GiteeUrl}"
                               ToolTip="{x:Static core:AppInfo.GiteeUrl}"
                               MouseLeftButtonUp="OnOpenGiteeClick" />
                </Grid>

                <!-- QQ 群 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="QQ 群" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{x:Static core:AppInfo.QqGroup}" />
                    <c:OutlineButton Grid.Column="2"
                                     Padding="12,6"
                                     FontSize="12"
                                     Content="复制群号"
                                     Click="OnCopyQqGroupClick" />
                </Grid>

                <!-- 项目官网 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="76" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="项目官网" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Accent.Base}"
                               Cursor="Hand"
                               Text="{x:Static core:AppInfo.WebsiteUrl}"
                               ToolTip="{x:Static core:AppInfo.WebsiteUrl}"
                               MouseLeftButtonUp="OnOpenWebsiteClick" />
                </Grid>

                <TextBlock x:Name="LabCopyHint"
                           Margin="0,10,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="复制后可直接在 QQ 里搜索群号。" />

                <TextBlock Margin="0,14,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="本工具不提供游戏本体分发；Mod 下载以当前登录用户的身份进行。" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="本软件保留所有权利（允许原样转发完整安装包），详见 LICENSE；参考的开源项目与许可证见 NOTICE。" />
            </StackPanel>
        </c:SurfaceCard>

        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton Width="88"
                             Height="36"
                             Content="关闭"
                             Tone="Solid"
                             Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
