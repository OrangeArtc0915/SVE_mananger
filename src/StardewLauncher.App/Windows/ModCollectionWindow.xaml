<w:LauncherWindow x:Class="StardewLauncher.App.Windows.ModCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="Mod 合集"
        Width="720"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Mod 合集" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="把当前启用的一整套 Mod 存下来，以后一键切回来。合集只记 Mod 的标识，不复制任何文件。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 新建 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtName"
                     Grid.Column="0"
                     Height="32"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Surface.Card}"
                     BorderBrush="{DynamicResource Border.Default}"
                     CaretBrush="{DynamicResource Text.Primary}"
                     Foreground="{DynamicResource Text.Primary}"
                     ToolTip="合集名字，例如「休闲档」「扩展档」" />

            <TextBox x:Name="TxtNote"
                     Grid.Column="1"
                     Height="32"
                     Margin="8,0,0,0"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Surface.Card}"
                     BorderBrush="{DynamicResource Border.Default}"
                     CaretBrush="{DynamicResource Text.Primary}"
                     Foreground="{DynamicResource Text.Primary}"
                     ToolTip="备注，可留空" />

            <c:OutlineButton x:Name="BtnCapture"
                             Grid.Column="2"
                             Height="32"
                             Margin="8,0,0,0"
                             Padding="12,0"
                             Content="保存当前启用为合集"
                             Tone="Solid"
                             Click="OnCaptureClick" />
        </Grid>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <!-- 合集列表 -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LabEmpty"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有任何合集。上面填个名字，点「保存当前启用为合集」就能把现在的 Mod 组合存下来。"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="PanCollections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,10"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="16,13,16,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <svg:SvgIcon Width="18"
                                                         Height="18"
                                                         VerticalAlignment="Center"
                                                         Icon="lucide/boxes"
                                                         IconBrush="{DynamicResource Accent.Base}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{Binding Name}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Note}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Tertiary}">
                                            <Run Text="{Binding CountText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding CreatedText}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <c:OutlineButton Grid.Column="1"
                                                     Height="30"
                                                     Padding="12,0"
                                                     VerticalAlignment="Center"
                                                     Content="套用"
                                                     Tag="{Binding}"
                                                     Tone="Outline"
                                                     Click="OnApplyClick" />

                                    <c:OutlineButton Grid.Column="2"
                                                     Height="30"
                                                     Margin="8,0,0,0"
                                                     Padding="12,0"
                                                     VerticalAlignment="Center"
                                                     Content="删除"
                                                     Tag="{Binding}"
                                                     Tone="Plain"
                                                     Click="OnDeleteClick" />
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnOpenMods"
                             Margin="0,0,8,0"
                             Content="打开 Mods 目录"
                             Tone="Outline"
                             Click="OnOpenModsDirClick" />
            <c:OutlineButton Width="88"
                             Height="36"
                             Content="完成"
                             Tone="Solid"
                             Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</w:LauncherWindow>
