<w:LauncherWindow x:Class="StardewLauncher.App.Windows.ModTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="标签"
        Width="540"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock FontSize="16" FontWeight="Bold" Text="标签" />
            <TextBlock x:Name="LabMod"
                       Margin="0,4,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   FontSize="11.5"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="勾选即为该 Mod 打上标签；标签按 Mod 的唯一标识保存，禁用 / 启用改名后不会丢失。"
                   TextWrapping="Wrap" />

        <!-- 已有标签 -->
        <ScrollViewer Grid.Row="2"
                      Margin="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           Text="已有标签" />

                <StackPanel x:Name="PanTags" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 新建标签 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtNewTagName"
                     Grid.Column="0"
                     Height="32"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     Background="{DynamicResource Surface.Card}"
                     BorderBrush="{DynamicResource Border.Default}"
                     CaretBrush="{DynamicResource Text.Primary}"
                     Foreground="{DynamicResource Text.Primary}"
                     ToolTip="输入新标签名字" />

            <ComboBox x:Name="CmbNewTagColor"
                      Grid.Column="1"
                      Width="110"
                      Height="32"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      Background="{DynamicResource Surface.Card}"
                      BorderBrush="{DynamicResource Border.Default}"
                      Foreground="{DynamicResource Text.Primary}"
                      ToolTip="标签颜色" />

            <c:OutlineButton x:Name="BtnCreateTag"
                             Grid.Column="2"
                             Width="80"
                             Height="32"
                             Margin="8,0,0,0"
                             Content="新建"
                             Tone="Solid"
                             Click="OnCreateClick" />
        </Grid>

        <!-- 底部 -->
        <StackPanel Grid.Row="4"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton Width="88"
                             Height="36"
                             Content="完成"
                             Tone="Solid"
                             Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</w:LauncherWindow>
