<Window x:Class="StardewLauncher.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        Title="星露谷启动器"
        Width="1080"
        Height="680"
        MinWidth="940"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{x:Null}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" UseLayoutRounding="True" SnapsToDevicePixels="True">

        <!-- 窗口外的留白用来显示自绘投影，玻璃化不可用时会退化为贴边窗口 -->
        <Border x:Name="PanBack" Margin="8" SnapsToDevicePixels="False" UseLayoutRounding="False">
            <Border.Clip>
                <RectangleGeometry x:Name="RectForm" RadiusX="12" RadiusY="12" />
            </Border.Clip>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  Opacity="0.22"
                                  ShadowDepth="0"
                                  Color="{DynamicResource Shadow.Tint}" />
            </Border.Effect>

            <Grid x:Name="PanForm" Background="{DynamicResource Brush.WindowBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题栏：暖色面板 + 底部分隔线，不使用整条强调色底 -->
                <Grid Grid.Row="0"
                      Background="{DynamicResource Surface.Panel}"
                      MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2"
                            Height="1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource Border.Default}"
                            IsHitTestVisible="False" />

                    <StackPanel Grid.Column="0"
                                Margin="16,0,12,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Width="24"
                                Height="24"
                                ClipToBounds="True"
                                CornerRadius="{StaticResource Radius.Small}">
                            <Image Width="20"
                                   Height="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
                                   Stretch="Uniform" />
                        </Border>
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="星露谷启动器" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <c:RoundIconButton Width="32"
                                           Height="32"
                                           Icon="lucide/circle-help"
                                           Tone="Plain"
                                           ToolTip="打开 GitHub 仓库"
                                           Click="OnHelpClick" />
                        <c:RoundIconButton Width="32"
                                           Height="32"
                                           Margin="4,0,0,0"
                                           Icon="lucide/minus"
                                           Tone="Plain"
                                           ToolTip="最小化"
                                           Click="OnMinimizeClick" />
                        <c:RoundIconButton Width="32"
                                           Height="32"
                                           Margin="4,0,0,0"
                                           Icon="lucide/x"
                                           Tone="Plain"
                                           ToolTip="关闭"
                                           Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <!-- 内容区：左侧全局导航 + 全宽内容 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <StackPanel Margin="0,12,0,0" VerticalAlignment="Top">
                                <c:NavItem x:Name="NavLaunch"
                                           GroupName="MainNav"
                                           Icon="lucide/play"
                                           Tag="0"
                                           Text="启动"
                                           Checked="OnNavChecked" />
                                <c:NavItem x:Name="NavMod"
                                           GroupName="MainNav"
                                           Icon="lucide/package"
                                           Tag="1"
                                           Text="Mod 管理"
                                           Checked="OnNavChecked" />
                                <c:NavItem x:Name="NavInstance"
                                           GroupName="MainNav"
                                           Icon="lucide/layers"
                                           Tag="2"
                                           Text="游戏实例"
                                           Checked="OnNavChecked" />
                                <c:NavItem x:Name="NavSetup"
                                           GroupName="MainNav"
                                           Icon="lucide/settings"
                                           Tag="3"
                                           Text="设置"
                                           Checked="OnNavChecked" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <!-- 单独分组，避免与主页面导航互斥；点击后弹独立窗口，不参与页面切换 -->
                                <c:NavItem x:Name="NavAbout"
                                           GroupName="AboutNav"
                                           Icon="lucide/info"
                                           Text="关于"
                                           Click="OnAboutNavClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="PanContent" Grid.Column="1" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
