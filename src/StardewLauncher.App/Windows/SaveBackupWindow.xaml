<Window x:Class="StardewLauncher.App.Windows.SaveBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="备份与回滚"
        Width="720"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：存档信息 + 新建备份 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="LabTitle"
                           FontSize="16"
                           FontWeight="Bold"
                           Text="备份与回滚"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LabPath"
                           Margin="0,4,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <c:OutlineButton x:Name="BtnOpenDir"
                                 Content="打开备份目录"
                                 Tone="Outline"
                                 Click="OnOpenDirClick" />
                <c:OutlineButton x:Name="BtnNewBackup"
                                 Margin="8,0,0,0"
                                 Content="新建备份"
                                 Tone="Solid"
                                 Click="OnNewBackupClick" />
            </StackPanel>
        </Grid>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 备份列表 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Border Background="{DynamicResource Surface.Card}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PanBackups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10"
                                        BorderBrush="{DynamicResource Border.Default}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{Binding TimeText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{Binding DetailText}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <c:OutlineButton Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Content="恢复"
                                                         IsEnabled="{Binding IsComplete}"
                                                         Tag="{Binding}"
                                                         Tone="Solid"
                                                         Click="OnRestoreClick" />

                                        <c:OutlineButton Grid.Column="2"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Content="删除"
                                                         Tag="{Binding}"
                                                         Tone="Danger"
                                                         Click="OnDeleteClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="LabEmpty"
                       MaxWidth="460"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="LabHint"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextTrimming="CharacterEllipsis" />

            <c:OutlineButton HorizontalAlignment="Right"
                             Content="关闭"
                             Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
