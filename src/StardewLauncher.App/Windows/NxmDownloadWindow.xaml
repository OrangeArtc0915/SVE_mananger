<w:LauncherWindow x:Class="StardewLauncher.App.Windows.NxmDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:StardewLauncher.App.Windows"
        xmlns:c="clr-namespace:StardewLauncher.App.Controls"
        xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
        Title="从 Nexus 下载 Mod"
        Width="620"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Window}"
        Foreground="{DynamicResource Text.Primary}"
        Icon="pack://application:,,,/StardewLauncher;component/Assets/AppIcon.png"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="OnWindowClosing">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 顶部：标题 + 链接 -->
            <StackPanel Orientation="Horizontal">
                <svg:SvgIcon Width="20"
                             Height="20"
                             VerticalAlignment="Center"
                             Icon="lucide/download"
                             IconBrush="{DynamicResource Accent.Base}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Text="从 Nexus 下载 Mod" />
            </StackPanel>

            <TextBlock x:Name="LabLink"
                       Margin="0,6,0,0"
                       FontSize="11.5"
                       Foreground="{DynamicResource Text.Tertiary}"
                       TextTrimming="CharacterEllipsis" />

            <!-- 提示（无凭证 / 查询失败等） -->
            <TextBlock x:Name="LabNotice"
                       Margin="0,10,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Status.Warn}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- Mod 信息 -->
            <c:SurfaceCard Margin="0,12,0,0" Title="Mod 信息">
                <StackPanel>
                    <StackPanel x:Name="PanBadges"
                                Margin="0,0,0,6"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <Border Padding="6,1"
                                Background="{DynamicResource Accent.Faint}"
                                CornerRadius="{StaticResource Radius.Pill}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent.Base}"
                                       Text="星露谷" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="LabModName"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Text="正在获取 Mod 信息…"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabModMeta"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabModSummary"
                               Margin="0,8,0,0"
                               MaxHeight="84"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabFileInfo"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 目标选择 -->
            <c:SurfaceCard x:Name="CardTarget" Margin="0,12,0,0" Title="下载到">
                <StackPanel>
                    <RadioButton x:Name="RadLibrary"
                                 GroupName="NxmTarget"
                                 IsChecked="True"
                                 Foreground="{DynamicResource Text.Primary}"
                                 Content="只下载到 Mod 库" />
                    <TextBlock x:Name="LabLibraryPath"
                               Margin="20,2,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextTrimming="CharacterEllipsis" />

                    <RadioButton x:Name="RadInstance"
                                 Margin="0,10,0,0"
                                 GroupName="NxmTarget"
                                 Foreground="{DynamicResource Text.Primary}"
                                 Content="下载并安装到当前实例" />
                    <TextBlock x:Name="LabInstancePath"
                               Margin="20,2,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 下载进度 -->
            <StackPanel x:Name="PanProgress" Margin="0,14,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="BarProgress"
                             Height="6"
                             Maximum="1"
                             Minimum="0"
                             Value="0" />
                <TextBlock x:Name="LabProgress"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- 结果 -->
            <c:SurfaceCard x:Name="CardResult"
                           Margin="0,12,0,0"
                           Title="结果"
                           Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LabResult"
                               FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabImport"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="LabAutoInstall"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Accent.Base}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="LabResultError"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Status.Danger}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </c:SurfaceCard>

            <!-- 底部按钮 -->
            <Grid Margin="0,14,0,0">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <c:OutlineButton x:Name="BtnOpenFolder"
                                     Content="打开下载目录"
                                     Visibility="Collapsed"
                                     Click="OnOpenFolderClick" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <c:OutlineButton x:Name="BtnOpenPage"
                                     Content="打开 Mod 页面"
                                     Click="OnOpenPageClick" />
                    <c:OutlineButton x:Name="BtnClose"
                                     Margin="8,0,0,0"
                                     Content="取消"
                                     Tone="Outline"
                                     Click="OnCloseClick" />
                    <c:OutlineButton x:Name="BtnDownload"
                                     Margin="8,0,0,0"
                                     Content="开始下载"
                                     Tone="Solid"
                                     Click="OnDownloadClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</w:LauncherWindow>
