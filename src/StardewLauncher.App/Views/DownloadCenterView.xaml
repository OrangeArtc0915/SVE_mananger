<UserControl x:Class="StardewLauncher.App.Views.DownloadCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
             Background="{DynamicResource Surface.Window}"
             FontFamily="{StaticResource AppFont}"
             Foreground="{DynamicResource Text.Primary}"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 分区切换 -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnTabNexus"
                             Content="Nexus 查询"
                             Tag="0"
                             Click="OnTabClick" />
            <c:OutlineButton x:Name="BtnTabUrl"
                             Margin="8,0,0,0"
                             Content="直链下载"
                             Tag="1"
                             Click="OnTabClick" />
            <c:OutlineButton x:Name="BtnTabFolder"
                             Margin="8,0,0,0"
                             Content="下载目录"
                             Tag="2"
                             Click="OnTabClick" />
            <c:OutlineButton x:Name="BtnTabStore"
                             Margin="8,0,0,0"
                             Content="获取游戏本体"
                             Tag="3"
                             Click="OnTabClick" />
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- ================= 分区 1：Nexus 查询 ================= -->
            <ScrollViewer x:Name="PanNexus"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12,10"
                            Background="{DynamicResource Accent.Faint}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgIcon Width="16"
                                         Height="16"
                                         Margin="0,1,0,0"
                                         VerticalAlignment="Top"
                                         Icon="lucide/info"
                                         IconBrush="{DynamicResource Accent.Base}" />
                            <TextBlock Margin="10,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap"
                                       Text="Nexus 的下载接口只对会员开放，这里查到信息后请到网页手动下载，下完可用「下载目录」分区一键入库。" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="BarNexusNoKey"
                            Margin="0,10,0,0"
                            Padding="12,10"
                            Background="{DynamicResource Status.WarnSoft}"
                            CornerRadius="{StaticResource Radius.Item}"
                            Visibility="Collapsed">
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap"
                                   Text="还没有配置 Nexus API Key，请到设置页填写。" />
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="40"
                                Padding="12,0"
                                Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <svg:SvgIcon Grid.Column="0"
                                             Width="15"
                                             Height="15"
                                             VerticalAlignment="Center"
                                             Icon="lucide/search"
                                             IconBrush="{DynamicResource Text.Tertiary}" />

                                <TextBox x:Name="TxtModInput"
                                         Grid.Column="1"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         ToolTip="输入 Mod ID 或 N 网页面链接，例如 2400 或 https://www.nexusmods.com/stardewvalley/mods/2400" />
                            </Grid>
                        </Border>

                        <c:OutlineButton x:Name="BtnNexusQuery"
                                         Grid.Column="1"
                                         Height="40"
                                         Margin="10,0,0,0"
                                         Content="查询"
                                         Tone="Solid"
                                         Click="OnNexusQueryClick" />
                    </Grid>

                    <TextBlock x:Name="LabNexusNotice"
                               Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <c:SurfaceCard x:Name="CardNexusResult"
                                   Margin="0,12,0,0"
                                   UseShadow="False"
                                   Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="LabModName"
                                           Grid.Column="0"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           TextWrapping="Wrap" />

                                <Border x:Name="PillNewVersion"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Padding="8,2"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Status.WarnSoft}"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        Visibility="Collapsed">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Status.Warn}"
                                               Text="有新版本" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="LabModMeta"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="LabModSummary"
                                       Margin="0,10,0,0"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="LabModStats"
                                       Margin="0,10,0,0"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Text.Tertiary}"
                                       TextWrapping="Wrap" />

                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <c:OutlineButton Content="打开下载页"
                                                 Tone="Solid"
                                                 Click="OnOpenModPageClick" />
                                <c:OutlineButton Margin="8,0,0,0"
                                                 Content="复制链接"
                                                 Click="OnCopyModLinkClick" />
                            </StackPanel>
                        </StackPanel>
                    </c:SurfaceCard>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 分区 2：直链下载 ================= -->
            <ScrollViewer x:Name="PanUrl"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Text="粘贴任意 zip 直链，下载后自动识别并入库到 Mod 库。非 zip 格式只会保存到本工具的下载目录，需要手动解压。" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="40"
                                Padding="12,0"
                                Background="{DynamicResource Surface.Card}"
                                BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <svg:SvgIcon Grid.Column="0"
                                             Width="15"
                                             Height="15"
                                             VerticalAlignment="Center"
                                             Icon="lucide/link-2"
                                             IconBrush="{DynamicResource Text.Tertiary}" />

                                <TextBox x:Name="TxtUrl"
                                         Grid.Column="1"
                                         Margin="8,0,0,0"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CaretBrush="{DynamicResource Text.Primary}"
                                         Foreground="{DynamicResource Text.Primary}"
                                         ToolTip="例如 https://example.com/some-mod.zip" />
                            </Grid>
                        </Border>

                        <c:OutlineButton x:Name="BtnStartUrl"
                                         Grid.Column="1"
                                         Height="40"
                                         Margin="10,0,0,0"
                                         Content="下载并入库"
                                         Tone="Solid"
                                         Click="OnStartDownloadClick" />
                    </Grid>

                    <Grid x:Name="PanUrlProgress" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="PrgUrl"
                                     Grid.Row="0"
                                     Height="6"
                                     Background="{DynamicResource Surface.Sunken}"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource Accent.Base}"
                                     Maximum="100"
                                     Minimum="0" />

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock x:Name="LabUrlProgress"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="0%" />

                            <c:OutlineButton HorizontalAlignment="Right"
                                             Padding="12,5"
                                             Content="取消"
                                             FontSize="12.5"
                                             Tone="Danger"
                                             Click="OnCancelDownloadClick" />
                        </Grid>
                    </Grid>

                    <TextBlock x:Name="LabUrlResult"
                               Margin="0,14,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- ================= 分区 3：下载目录监控 ================= -->
            <Grid x:Name="PanFolder" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="监控目录" />

                    <Border Grid.Column="1"
                            Height="36"
                            Margin="10,0,0,0"
                            Padding="12,0"
                            Background="{DynamicResource Surface.Sunken}"
                            CornerRadius="{StaticResource Radius.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <svg:SvgIcon Grid.Column="0"
                                         Width="14"
                                         Height="14"
                                         VerticalAlignment="Center"
                                         Icon="lucide/folder-open"
                                         IconBrush="{DynamicResource Text.Tertiary}" />

                            <TextBlock x:Name="LabWatchFolder"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <c:OutlineButton Grid.Column="2"
                                     Height="36"
                                     Margin="10,0,0,0"
                                     Content="浏览…"
                                     Click="OnBrowseWatchFolderClick" />

                    <c:OutlineButton x:Name="BtnScanPackages"
                                     Grid.Column="3"
                                     Height="36"
                                     Margin="10,0,0,0"
                                     Content="扫描"
                                     Tone="Solid"
                                     Click="OnScanPackagesClick" />
                </Grid>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Text="浏览器下载完 Mod 后，点这里扫描即可一键入库。已入库过的文件本轮不再重复列出。" />

                <ProgressBar x:Name="PrgPackages"
                             Grid.Row="2"
                             Height="6"
                             Margin="0,10,0,0"
                             Background="{DynamicResource Surface.Sunken}"
                             BorderThickness="0"
                             Foreground="{DynamicResource Accent.Base}"
                             Maximum="100"
                             Minimum="0"
                             Visibility="Collapsed" />

                <TextBlock x:Name="LabPackagesResult"
                           Grid.Row="2"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PanPackages">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <c:MasonryPanel Mode="AutoFit"
                                                    ColumnGap="12"
                                                    ItemWidth="340"
                                                    RowGap="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Ring"
                                            Padding="2"
                                            BorderBrush="{DynamicResource Common.Transparent}"
                                            BorderThickness="2"
                                            CornerRadius="14"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="OnPackageClick"
                                            Tag="{Binding}">
                                        <c:SurfaceCard HasHoverEffect="False" UseShadow="False">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <svg:SvgIcon Width="16"
                                                                 Height="16"
                                                                 Margin="0,1,0,0"
                                                                 VerticalAlignment="Top"
                                                                 Icon="lucide/file-archive"
                                                                 IconBrush="{DynamicResource Accent.Base}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding FileName}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>

                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding MetaText}"
                                                           TextWrapping="Wrap" />

                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Status.Success}"
                                                           Text="{Binding ModBadgeText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasLooksLikeMod, Converter={StaticResource BoolToVis}}" />

                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Status.Warn}"
                                                           Text="{Binding InspectError}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasInspectError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </c:SurfaceCard>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent.Base}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="LabPackagesEmpty"
                               MaxWidth="520"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="LabSelectedPackages"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="已选 0 个" />

                    <c:OutlineButton x:Name="BtnImportPackages"
                                     Width="110"
                                     Height="36"
                                     HorizontalAlignment="Right"
                                     Content="入库选中"
                                     IsEnabled="False"
                                     Tone="Solid"
                                     Click="OnImportPackagesClick" />
                </Grid>
            </Grid>

            <!-- ================= 分区 4：获取游戏本体 ================= -->
            <ScrollViewer x:Name="PanStore"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <Border Padding="12,10"
                            Background="{DynamicResource Accent.Faint}"
                            CornerRadius="{StaticResource Radius.Item}">
                        <StackPanel Orientation="Horizontal">
                            <svg:SvgIcon Width="16"
                                         Height="16"
                                         Margin="0,1,0,0"
                                         VerticalAlignment="Top"
                                         Icon="lucide/shield-check"
                                         IconBrush="{DynamicResource Accent.Base}" />
                            <TextBlock Margin="10,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextWrapping="Wrap"
                                       Text="本工具不提供游戏本体下载，请通过官方渠道获取。" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="PanStoreLinks" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:SurfaceCard Margin="0,0,0,10" HasHoverEffect="False" UseShadow="False">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.Primary}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Text.Tertiary}"
                                                       Text="{Binding Note}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <c:OutlineButton Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Content="打开"
                                                         Tag="{Binding}"
                                                         Click="OnOpenStoreClick" />
                                    </Grid>
                                </c:SurfaceCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
