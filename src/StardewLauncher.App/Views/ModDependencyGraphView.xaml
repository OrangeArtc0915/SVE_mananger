<UserControl x:Class="StardewLauncher.App.Views.ModDependencyGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <CheckBox x:Name="ChkOnlyConnected"
                      VerticalAlignment="Center"
                      Content="只看有依赖关系的"
                      Foreground="{DynamicResource Text.Primary}"
                      IsChecked="True"
                      Checked="OnFilterChanged"
                      Unchecked="OnFilterChanged" />
            <c:OutlineButton x:Name="BtnZoomOut"
                             Width="34"
                             Height="30"
                             Margin="12,0,0,0"
                             Content="−"
                             Tone="Outline"
                             Click="OnZoomOutClick" />
            <c:OutlineButton x:Name="BtnZoomIn"
                             Width="34"
                             Height="30"
                             Margin="6,0,0,0"
                             Content="+"
                             Tone="Outline"
                             Click="OnZoomInClick" />
            <c:OutlineButton x:Name="BtnFit"
                             Height="30"
                             Margin="6,0,0,0"
                             Padding="10,0"
                             Content="适应窗口"
                             Tone="Outline"
                             Click="OnFitClick" />
            <c:OutlineButton x:Name="BtnRefresh"
                             Height="30"
                             Margin="6,0,0,0"
                             Content="重新加载"
                             Tone="Solid"
                             Click="OnRefreshClick" />
        </StackPanel>

        <!-- 摘要 -->
        <c:SurfaceCard Grid.Row="1"
                       Margin="0,10,0,0"
                       Padding="0"
                       HasHoverEffect="False"
                       UseShadow="False">
            <Grid Margin="16,13,16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconSummary"
                             Grid.Column="0"
                             Width="22"
                             Height="22"
                             VerticalAlignment="Center"
                             Icon="lucide/network"
                             IconBrush="{DynamicResource Status.Success}" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="LabSummaryTitle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="还没加载"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabSummaryDetail"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="点右上角「重新加载」读一遍当前实例的 Mods 目录"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </c:SurfaceCard>

        <!-- 选中节点的详情 -->
        <Border x:Name="BarDetail"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="14,11"
                Background="{DynamicResource Surface.Sunken}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="LabDetailTitle"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabDetailDeps"
                               Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabDetailUsers"
                               Margin="0,2,0,0"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <c:RoundIconButton Grid.Column="1"
                                   VerticalAlignment="Top"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnCloseDetailClick" />
            </Grid>
        </Border>

        <!-- 画布 -->
        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Background="{DynamicResource Surface.Sunken}"
                CornerRadius="{StaticResource Radius.Item}"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="Scroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="Surface"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent" />
                </ScrollViewer>

                <TextBlock x:Name="LabEmpty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有可以画的依赖关系。"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
