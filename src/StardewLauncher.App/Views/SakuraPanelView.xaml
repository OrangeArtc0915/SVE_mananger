<UserControl x:Class="StardewLauncher.App.Views.SakuraPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource Surface.Window}"
             FontFamily="{StaticResource AppFont}"
             Foreground="{DynamicResource Text.Primary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface.Panel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <c:RoundIconButton x:Name="BtnBack"
                                   Icon="lucide/arrow-left"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="后退"
                                   Click="OnBackClick" />
                <c:RoundIconButton x:Name="BtnForward"
                                   Margin="2,0,0,0"
                                   Icon="lucide/arrow-right"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="前进"
                                   Click="OnForwardClick" />
                <c:RoundIconButton x:Name="BtnRefresh"
                                   Margin="2,0,0,0"
                                   Icon="lucide/refresh-cw"
                                   IsEnabled="False"
                                   Tone="Plain"
                                   ToolTip="刷新"
                                   Click="OnRefreshClick" />
            </StackPanel>

            <Border Grid.Column="1"
                    Height="26"
                    Margin="8,0,10,0"
                    Padding="10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface.Sunken}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Button}">
                <TextBlock x:Name="LabAddress"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Border.Default}" />

        <!-- 内容区：内嵌樱花FRP 网页版面板；初始化失败时用提示卡覆盖 -->
        <Grid Grid.Row="2">
            <wv2:WebView2 x:Name="Browser" />

            <Border x:Name="PanError"
                    Background="{DynamicResource Surface.Window}"
                    Visibility="Collapsed">
                <c:SurfaceCard MaxWidth="460"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Title="内嵌面板不可用"
                               UseShadow="False">
                    <StackPanel>
                        <TextBlock x:Name="LabError"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text.Tertiary}"
                                   TextWrapping="Wrap"
                                   Text="内嵌面板需要 Microsoft Edge WebView2 Runtime；Windows 11 自带，Windows 10 装一次免费的运行时即可。装好后重进本页会自动重试。" />
                    </StackPanel>
                </c:SurfaceCard>
            </Border>
        </Grid>
    </Grid>
</UserControl>
