<UserControl x:Class="StardewLauncher.App.Views.GameFileRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnOpenDir"
                             Content="打开游戏目录"
                             Tone="Outline"
                             Click="OnOpenGameDirClick" />
            <c:OutlineButton x:Name="BtnRefresh"
                             Margin="8,0,0,0"
                             Content="重新扫描"
                             Tone="Solid"
                             Click="OnRefreshClick" />
        </StackPanel>

        <!-- 摘要 -->
        <c:SurfaceCard Grid.Row="1"
                       Margin="0,10,0,0"
                       Padding="0"
                       HasHoverEffect="False"
                       UseShadow="False">
            <Grid Margin="16,13,16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconSummary"
                             Grid.Column="0"
                             Width="22"
                             Height="22"
                             VerticalAlignment="Center"
                             Icon="lucide/rotate-ccw"
                             IconBrush="{DynamicResource Accent.Base}" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="LabSummaryTitle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="还没扫描"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabSummaryDetail"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="点右上角「重新扫描」看看有没有可还原的原版文件"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </c:SurfaceCard>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <!-- 可还原的文件 -->
        <ScrollViewer x:Name="ScrollItems"
                      Grid.Row="3"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PanItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SurfaceCard Margin="0,0,0,10"
                                       Padding="0"
                                       HasHoverEffect="False"
                                       UseShadow="False">
                            <Grid Margin="16,13,16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <svg:SvgIcon Grid.Column="0"
                                             Width="18"
                                             Height="18"
                                             Margin="0,2,0,0"
                                             VerticalAlignment="Top"
                                             Icon="lucide/rotate-ccw"
                                             IconBrush="{DynamicResource Accent.Base}" />

                                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="{Binding FileName}"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding FolderText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="11"
                                               Text="{Binding OriginText}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Registered}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Status.Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding CreatedText}" />
                                    <TextBlock Margin="0,2,0,0"
                                               HorizontalAlignment="Right"
                                               FontSize="11"
                                               Foreground="{DynamicResource Text.Tertiary}"
                                               Text="{Binding SizeText}" />

                                    <c:OutlineButton Margin="0,8,0,0"
                                                     HorizontalAlignment="Right"
                                                     Content="还原这个文件"
                                                     Tag="{Binding}"
                                                     Tone="Outline"
                                                     Click="OnRestoreClick" />
                                </StackPanel>
                            </Grid>
                        </c:SurfaceCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
