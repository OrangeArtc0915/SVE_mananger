<UserControl x:Class="StardewLauncher.App.Views.SmapiInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg"
             Background="{DynamicResource Surface.Window}"
             FontFamily="{StaticResource AppFont}"
             Foreground="{DynamicResource Text.Primary}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>

        <!-- 线路切换 -->
        <c:SurfaceCard Title="安装线路">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <c:OutlineButton x:Name="BtnOfficial"
                                     Content="官方（GitHub Releases）"
                                     Tone="Solid"
                                     Click="OnChannelOfficialClick" />
                    <c:OutlineButton x:Name="BtnCloud"
                                     Margin="8,0,0,0"
                                     Content="启动器云端仓库"
                                     Tone="Outline"
                                     Click="OnChannelCloudClick" />
                </StackPanel>

                <!-- 云端线路下的下载源切换。两边内容一致，按本机网络情况挑 -->
                <StackPanel x:Name="PanCloudSource"
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11.5"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Text="下载源" />
                    <c:OutlineButton x:Name="BtnSourceGithub"
                                     Margin="8,0,0,0"
                                     Padding="10,4"
                                     FontSize="11.5"
                                     Content="GitHub"
                                     Click="OnSourceGithubClick" />
                    <c:OutlineButton x:Name="BtnSourceGitee"
                                     Margin="6,0,0,0"
                                     Padding="10,4"
                                     FontSize="11.5"
                                     Content="Gitee"
                                     Click="OnSourceGiteeClick" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Text="（国内网络建议选 Gitee）" />
                </StackPanel>
            </StackPanel>
        </c:SurfaceCard>

        <!-- 版本信息 -->
        <c:SurfaceCard Margin="0,12,0,0" Title="版本信息">
            <StackPanel>
                <TextBlock x:Name="LabInfo"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="正在获取…"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="LabInfoUrl"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </c:SurfaceCard>

        <!-- 安装目录 -->
        <c:SurfaceCard Margin="0,12,0,0" Title="安装目录">
            <StackPanel>
                <!-- 直接选已有游戏实例，省得手填路径 -->
                <Grid x:Name="PanInstancePicker" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="游戏实例" />

                    <ComboBox x:Name="CmbInstance"
                              Grid.Column="1"
                              Height="32"
                              Margin="10,0,0,0"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource Surface.Card}"
                              BorderBrush="{DynamicResource Border.Default}"
                              DisplayMemberPath="Text"
                              Foreground="{DynamicResource Text.Primary}"
                              SelectionChanged="OnInstanceChanged"
                              ToolTip="选择一个游戏实例，安装到它的游戏目录" />
                </Grid>

                <TextBlock x:Name="LabNoInstance"
                           Margin="0,0,0,8"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有游戏实例，可以在「游戏实例」页新建，或直接填下面的目录。"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtGameDir"
                             Grid.Column="0"
                             Height="34"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource Surface.Card}"
                             BorderBrush="{DynamicResource Border.Default}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource Text.Primary}"
                             Foreground="{DynamicResource Text.Primary}"
                             TextChanged="OnGameDirChanged" />

                    <c:OutlineButton Grid.Column="1"
                                     Margin="8,0,0,0"
                                     Content="浏览…"
                                     Click="OnBrowseClick" />
                </Grid>

                <TextBlock x:Name="LabDirState"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="LabInstallerPaths"
                           Margin="0,6,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </c:SurfaceCard>

        <!-- 进度 -->
        <StackPanel x:Name="PanProgress" Margin="0,14,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="BarProgress"
                         Height="6"
                         Maximum="1"
                         Minimum="0"
                         Value="0" />
            <TextBlock x:Name="LabProgress"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- 结果 -->
        <c:SurfaceCard x:Name="CardResult"
                       Margin="0,12,0,0"
                       Title="结果"
                       Visibility="Collapsed">
            <TextBlock x:Name="LabResult"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </c:SurfaceCard>

        <!-- 底部按钮 -->
        <StackPanel Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnInstall"
                             Content="下载并安装"
                             Tone="Solid"
                             Click="OnInstallClick" />
            <c:OutlineButton x:Name="BtnManual"
                             Margin="8,0,0,0"
                             Content="手动安装…"
                             Click="OnManualClick" />
            <c:OutlineButton x:Name="BtnClose"
                             Margin="8,0,0,0"
                             Content="取消"
                             IsEnabled="False"
                             Click="OnCloseClick" />
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
