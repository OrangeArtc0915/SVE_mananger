<UserControl x:Class="StardewLauncher.App.Views.QuickFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnAdd"
                             Content="收藏一个目录…"
                             Tone="Solid"
                             Click="OnAddClick" />
        </StackPanel>

        <!-- 提示条 -->
        <Border x:Name="BarNotice"
                Grid.Row="1"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           Text="内置目录" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="跟着当前实例和设置走，换实例或改设置后这里会自动变。"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="PanBuiltIn" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,8"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="14,11,14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <svg:SvgIcon Grid.Column="0"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,2,0,0"
                                                 VerticalAlignment="Top"
                                                 Icon="{Binding Icon}"
                                                 IconBrush="{DynamicResource Accent.Base}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Note}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding Path}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <c:OutlineButton Grid.Column="2"
                                                     Height="28"
                                                     Padding="10,0"
                                                     VerticalAlignment="Center"
                                                     Content="打开"
                                                     Tag="{Binding}"
                                                     Tone="Outline"
                                                     Click="OnOpenClick" />
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,18,0,0"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"
                           Text="我的收藏" />

                <TextBlock x:Name="LabCustomEmpty"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource Text.Tertiary}"
                           Text="还没有收藏任何目录。右上角「收藏一个目录…」挑一个加进来。"
                           TextWrapping="Wrap" />

                <ItemsControl x:Name="PanCustom" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SurfaceCard Margin="0,0,0,8"
                                           Padding="0"
                                           HasHoverEffect="False"
                                           UseShadow="False">
                                <Grid Margin="14,11,14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <svg:SvgIcon Grid.Column="0"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,2,0,0"
                                                 VerticalAlignment="Top"
                                                 Icon="{Binding Icon}"
                                                 IconBrush="{DynamicResource Accent.Base}" />

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding Name}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Note}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource Text.Tertiary}"
                                                   Text="{Binding Path}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <c:OutlineButton Grid.Column="2"
                                                     Height="28"
                                                     Padding="10,0"
                                                     VerticalAlignment="Center"
                                                     Content="打开"
                                                     Tag="{Binding}"
                                                     Tone="Outline"
                                                     Click="OnOpenClick" />

                                    <c:OutlineButton Grid.Column="3"
                                                     Height="28"
                                                     Margin="6,0,0,0"
                                                     Padding="10,0"
                                                     VerticalAlignment="Center"
                                                     Content="移除"
                                                     Tag="{Binding}"
                                                     Tone="Plain"
                                                     Click="OnRemoveClick" />
                                </Grid>
                            </c:SurfaceCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
