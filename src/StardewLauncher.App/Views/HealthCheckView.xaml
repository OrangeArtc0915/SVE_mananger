<UserControl x:Class="StardewLauncher.App.Views.HealthCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:StardewLauncher.App.Controls"
             xmlns:svg="clr-namespace:StardewLauncher.App.Controls.Svg">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <c:OutlineButton x:Name="BtnCopy"
                             Content="复制报告"
                             Tone="Outline"
                             Click="OnCopyClick" />
            <c:OutlineButton x:Name="BtnPackage"
                             Margin="8,0,0,0"
                             Content="导出反馈包"
                             Tone="Outline"
                             Click="OnPackageClick" />
            <c:OutlineButton x:Name="BtnRefresh"
                             Margin="8,0,0,0"
                             Content="重新体检"
                             Tone="Solid"
                             Click="OnRefreshClick" />
        </StackPanel>

        <!-- 总览 -->
        <c:SurfaceCard Grid.Row="1"
                       Margin="0,10,0,0"
                       Padding="0"
                       HasHoverEffect="False"
                       UseShadow="False">
            <Grid Margin="16,13,16,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconSummary"
                             Grid.Column="0"
                             Width="22"
                             Height="22"
                             VerticalAlignment="Center"
                             Icon="lucide/shield-check"
                             IconBrush="{DynamicResource Status.Success}" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="LabSummaryTitle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="还没体检"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LabSummaryDetail"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="点右上角「重新体检」把环境信息扫一遍"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </c:SurfaceCard>

        <!-- 提示条：操作结果 -->
        <Border x:Name="BarNotice"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="12,10"
                Background="{DynamicResource Accent.Faint}"
                CornerRadius="{StaticResource Radius.Item}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <svg:SvgIcon x:Name="IconNotice"
                             Grid.Column="0"
                             Width="16"
                             Height="16"
                             Margin="0,1,0,0"
                             VerticalAlignment="Top"
                             Icon="lucide/info"
                             IconBrush="{DynamicResource Accent.Base}" />

                <TextBlock x:Name="LabNotice"
                           Grid.Column="1"
                           Margin="10,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Text.Primary}"
                           TextWrapping="Wrap" />

                <c:RoundIconButton Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Icon="lucide/x"
                                   IconSize="13"
                                   Tone="Plain"
                                   Click="OnDismissNoticeClick" />
            </Grid>
        </Border>

        <!-- 体检条目 -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PanItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:SurfaceCard Margin="0,0,0,10"
                                       Padding="0"
                                       HasHoverEffect="False"
                                       UseShadow="False">
                            <Grid Margin="16,13,16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <svg:SvgIcon Grid.Column="0"
                                             Width="18"
                                             Height="18"
                                             Margin="0,2,0,0"
                                             VerticalAlignment="Top">
                                    <svg:SvgIcon.Style>
                                        <Style TargetType="svg:SvgIcon">
                                            <Setter Property="Icon" Value="lucide/info" />
                                            <Setter Property="IconBrush" Value="{DynamicResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                    <Setter Property="Icon" Value="lucide/circle-check" />
                                                    <Setter Property="IconBrush" Value="{DynamicResource Status.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Icon" Value="lucide/triangle-alert" />
                                                    <Setter Property="IconBrush" Value="{DynamicResource Status.Warn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Fail">
                                                    <Setter Property="Icon" Value="lucide/triangle-alert" />
                                                    <Setter Property="IconBrush" Value="{DynamicResource Status.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </svg:SvgIcon.Style>
                                </svg:SvgIcon>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text.Primary}"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap" />
                                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,1,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Text.Tertiary}"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Padding="7,2"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Surface.Sunken}"
                                        CornerRadius="{StaticResource Radius.Pill}">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding LevelText}" />
                                </Border>
                            </Grid>
                        </c:SurfaceCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
