<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StardewLauncher.App</RootNamespace>
    <AssemblyName>StardewLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- 版本号不在这里写死：唯一来源是 Core\App\AppInfo.cs，由 build.bat 读取后传给 MSBuild -->
    <Product>星露谷启动器</Product>
    <Company>mmm</Company>
    <AssemblyTitle>星露谷启动器</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\IconPacks\**\*.svg" />
    <Resource Include="Assets\Art\**\*.png" />
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\Art\AppIconSource.jpg" />
  </ItemGroup>

  <!--
    EasyTier 组网工具（约 33 MB）。作为嵌入资源随单文件 exe 一起分发，
    首次使用联机功能时由 EasyTierAssets 自解压到数据目录。
    不能放进上面的 Resource 组：那会进 .g.resources，运行时取不出来。
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\EasyTier\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StardewLauncher.Core\StardewLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
